root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,razor,css,js,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Documentazione XML non richiesta su membri pubblici
dotnet_diagnostic.CS1591.severity = none

# I nomi dei tipi di campo (Integer, Decimal) sono vocabolario di dominio, non ambiguita'
dotnet_diagnostic.CA1720.severity = none

# "puo' essere static": rumoroso sui servizi risolti da DI
dotnet_diagnostic.CA1822.severity = suggestion

# LoggerMessage source-generated: utile nei percorsi caldi, eccessivo per i log di avvio
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
