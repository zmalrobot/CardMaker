@page "/admin/ai"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using CardMaker.AI.Models
@using CardMaker.Application.Ai
@using CardMaker.Contracts.Ai
@inject IAiConfigurationService AiConfigService
@inject IHardwareProfileDetector HardwareDetector
@inject IAiModelManager ModelManager

<PageTitle>Intelligenza Artificiale — CardMaker Admin</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">🤖 Configurazione Intelligenza Artificiale</h1>
            <p class="text-muted mb-0">Gestione motore di inferenza locale basato su llama.cpp e modelli Google Gemma.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="DownloadActiveModelAsync" disabled="@(IsSaving || ModelManager.CurrentStatus == AiModelReadinessStatus.Downloading)">
                <span>⬇️ Scarica Modello Testo</span>
            </button>
            <button class="btn btn-outline-primary" @onclick="DownloadActiveImageModelAsync" disabled="@(IsSaving || ModelManager.CurrentImageStatus == AiModelReadinessStatus.Downloading)">
                <span>🎨 Scarica Modello Immagini</span>
            </button>
            <button class="btn btn-primary" @onclick="SaveSettingsAsync" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Salvataggio...</span>
                }
                else
                {
                    <span>💾 Salva Impostazioni</span>
                }
            </button>
        </div>
    </div>

    @if (SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <span>@SuccessMessage</span>
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border shadow-sm h-100">
                <div class="card-header bg-surface-1 py-3">
                    <h5 class="card-title mb-0 fw-semibold">⚙️ Generazione Testo AI (Gemma)</h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="aiEnabledToggle" @bind="Settings.IsEnabled" style="cursor: pointer; transform: scale(1.2); margin-right: 0.8rem;" />
                        <label class="form-check-label fw-bold" for="aiEnabledToggle" style="cursor: pointer;">
                            Abilita generazione testo AI nell'applicazione
                        </label>
                        <div class="form-text mt-1">
                            Se disabilitato, il pulsante di generazione assistita per testo viene rimosso dall'editor delle carte.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Selezione Modello Testo / Override</label>
                        <select class="form-select" @bind="Settings.SelectedModelKey">
                            <option value="@AiModelRegistry.AutoModelKey">🤖 Auto (Rilevamento hardware dinamico - Consigliato)</option>
                            @foreach (var model in AvailableTextModels)
                            {
                                <option value="@model.Key">@model.DisplayName (Consiglia >= @model.RecommendedRamGb GB RAM)</option>
                            }
                        </select>
                        <div class="form-text">
                            In modalita <code>Auto</code>, l'applicazione seleziona la versione ottimale di Gemma in base alla RAM fisica dell'host.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Thread CPU Allocati</label>
                        <input type="number" class="form-control" @bind="Settings.CpuThreads" min="0" max="128" />
                        <div class="form-text">
                            Lasciare impostato a <code>0</code> per allocare automaticamente <code>ProcessorCount - 1</code> thread mantenendo il sistema reattivo.
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Cartella Modelli GGUF</label>
                        <input type="text" class="form-control bg-light" readonly value="@AiConfigService.GetModelsDirectory()" />
                        <div class="form-text">
                            I file <code>.gguf</code> scaricati vengono memorizzati in questa directory.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border shadow-sm h-100">
                <div class="card-header bg-surface-1 py-3">
                    <h5 class="card-title mb-0 fw-semibold">🎨 Generazione Immagini AI (Stable Diffusion)</h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="aiImageEnabledToggle" @bind="Settings.IsImageGenerationEnabled" style="cursor: pointer; transform: scale(1.2); margin-right: 0.8rem;" />
                        <label class="form-check-label fw-bold" for="aiImageEnabledToggle" style="cursor: pointer;">
                            Abilita generazione immagini AI nell'applicazione
                        </label>
                        <div class="form-text mt-1">
                            Se disabilitato, il pulsante 🎨 Artwork AI viene rimosso dall'editor delle carte e nessun modello di diffusione viene scaricato.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Selezione Modello Immagini / Override</label>
                        <select class="form-select" @bind="Settings.SelectedImageModelKey">
                            <option value="@AiModelRegistry.AutoModelKey">🤖 Auto (Rilevamento hardware dinamico - Consigliato)</option>
                            @foreach (var model in AvailableImageModels)
                            {
                                <option value="@model.Key">@model.DisplayName (Consiglia >= @model.RecommendedRamGb GB RAM)</option>
                            }
                        </select>
                        <div class="form-text">
                            In modalita <code>Auto</code>, l'applicazione seleziona il modello di diffusione ottimale in base alla memoria di sistema.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Stato Modello Immagini:</label>
                        <div>
                            @switch (ModelManager.CurrentImageStatus)
                            {
                                case AiModelReadinessStatus.Ready:
                                    <span class="badge bg-success fs-6 py-2 px-3">
                                        ✅ Pronto all'uso (Validato)
                                    </span>
                                    break;
                                case AiModelReadinessStatus.Downloading:
                                    <span class="badge bg-primary fs-6 py-2 px-3">
                                        ⬇️ Download in corso (@(ModelManager.CurrentImageProgress?.Percentage.ToString("0.0"))%)
                                    </span>
                                    break;
                                case AiModelReadinessStatus.Validating:
                                    <span class="badge bg-warning text-dark fs-6 py-2 px-3">
                                        🔍 Validazione integrita in corso...
                                    </span>
                                    break;
                                case AiModelReadinessStatus.Checking:
                                    <span class="badge bg-info fs-6 py-2 px-3">
                                        🔎 Verifica file locale...
                                    </span>
                                    break;
                                case AiModelReadinessStatus.Disabled:
                                    <span class="badge bg-secondary fs-6 py-2 px-3">
                                        ⏸️ Generazione Immagini Disabilitata
                                    </span>
                                    break;
                                case AiModelReadinessStatus.Error:
                                    <span class="badge bg-danger fs-6 py-2 px-3">
                                        ⚠️ Errore o modello assente
                                    </span>
                                    break;
                            }
                            @if (!string.IsNullOrEmpty(ModelManager.ActiveImageModelPath))
                            {
                                <div class="small text-muted mt-1">Percorso: <code>@ModelManager.ActiveImageModelPath</code></div>
                            }
                        </div>
                    </div>

                    @if (ModelManager.CurrentImageStatus == AiModelReadinessStatus.Downloading && ModelManager.CurrentImageProgress != null)
                    {
                        var pi = ModelManager.CurrentImageProgress;
                        <div class="p-3 bg-surface-2 rounded mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Download: <strong>@Math.Round((double)pi.BytesDownloaded / (1024*1024), 1) MB</strong> di <strong>@Math.Round((double)pi.TotalBytes / (1024*1024), 1) MB</strong></span>
                                <span>@pi.Percentage.ToString("0.0")%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: @pi.Percentage%;"></div>
                            </div>
                        </div>
                    }

                    <div class="alert alert-light border py-2 px-3 small mb-0">
                        <strong>💡 Gestione della memoria (VRAM/RAM):</strong><br />
                        I modelli di diffusione vengono caricati in memoria solo durante la generazione e rilasciati immediatamente alla chiusura del popup.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border shadow-sm">
                <div class="card-header bg-surface-1 py-3">
                    <h5 class="card-title mb-0 fw-semibold">🖥️ Stato Hardware & Modello Testo</h5>
                </div>
                <div class="card-body">
                    @if (HardwareProfile != null)
                    {
                        <div class="row align-items-center mb-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center gap-3 p-3 bg-surface-2 rounded">
                                    <span class="fs-1">🧠</span>
                                    <div>
                                        <div class="fw-bold fs-5">@HardwareProfile.TotalPhysicalMemoryGb GB RAM Totale</div>
                                        <div class="text-muted small">Memoria fisica rilevata dal sistema operativo</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-surface-2 rounded">
                                    <div class="small fw-semibold text-muted">Modello Testo Consigliato:</div>
                                    <div class="fw-bold text-primary">@HardwareProfile.RecommendedModelDisplayName</div>
                                    <div class="small text-muted">Stato: <strong>@ModelManager.CurrentStatus</strong></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-surface-2 rounded">
                                    <div class="small fw-semibold text-muted">Modello Immagini Consigliato:</div>
                                    <div class="fw-bold text-primary">@(RecommendedImageModel?.DisplayName ?? "Non rilevato")</div>
                                    <div class="small text-muted">Stato: <strong>@ModelManager.CurrentImageStatus</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Stato di Disponibilita Modello Testo:</label>
                            <div>
                                @switch (ModelManager.CurrentStatus)
                                {
                                    case AiModelReadinessStatus.Ready:
                                        <span class="badge bg-success fs-6 py-2 px-3">
                                            ✅ Pronto all'uso (Validato)
                                        </span>
                                        break;
                                    case AiModelReadinessStatus.Downloading:
                                        <span class="badge bg-primary fs-6 py-2 px-3">
                                            ⬇️ Download in corso (@(ModelManager.CurrentProgress?.Percentage.ToString("0.0"))%)
                                        </span>
                                        break;
                                    case AiModelReadinessStatus.Validating:
                                        <span class="badge bg-warning text-dark fs-6 py-2 px-3">
                                            🔍 Validazione integrita in corso...
                                        </span>
                                        break;
                                    case AiModelReadinessStatus.Checking:
                                        <span class="badge bg-info fs-6 py-2 px-3">
                                            🔎 Verifica file locale...
                                        </span>
                                        break;
                                    case AiModelReadinessStatus.Disabled:
                                        <span class="badge bg-secondary fs-6 py-2 px-3">
                                            ⏸️ Generazione Testo Disabilitata
                                        </span>
                                        break;
                                    case AiModelReadinessStatus.Error:
                                        <span class="badge bg-danger fs-6 py-2 px-3">
                                            ⚠️ Errore o modello assente
                                        </span>
                                        break;
                                }
                                <div class="small text-muted mt-1">Percorso: <code>@HardwareProfile.ModelPath</code></div>
                            </div>
                        </div>

                        @if (ModelManager.CurrentStatus == AiModelReadinessStatus.Downloading && ModelManager.CurrentProgress != null)
                        {
                            var p = ModelManager.CurrentProgress;
                            <div class="p-3 bg-surface-2 rounded mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Download: <strong>@Math.Round((double)p.BytesDownloaded / (1024*1024), 1) MB</strong> di <strong>@Math.Round((double)p.TotalBytes / (1024*1024), 1) MB</strong></span>
                                    <span>@p.Percentage.ToString("0.0")%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" style="width: @p.Percentage%;"></div>
                                </div>
                            </div>
                        }

                        <div class="alert alert-info py-2 px-3 small mb-0">
                            <strong>💡 Download automatico:</strong><br />
                            L'applicazione verifica e scarica automaticamente i modelli necessari in background all'avvio.
                            In caso di interruzioni, il download riprende automaticamente tramite HTTP Range.
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">
                            <span class="spinner-border spinner-border-sm me-1"></span> Rilevamento memoria in corso...
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-surface-1 py-3">
                    <h5 class="card-title mb-0 fw-semibold">📚 Modelli Testo della Famiglia Gemma</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Modello</th>
                                <th>File Atteso (.gguf)</th>
                                <th>Dimensione</th>
                                <th>RAM Minima</th>
                                <th>Uso Stimato</th>
                                <th>HuggingFace</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var model in AvailableTextModels)
                            {
                                var isCurrent = (Settings.SelectedModelKey == model.Key) || 
                                                (Settings.SelectedModelKey == AiModelRegistry.AutoModelKey && HardwareProfile?.RecommendedModelKey == model.Key);
                                <tr class="@(isCurrent ? "table-primary" : "")">
                                    <td>
                                        <strong>@model.DisplayName</strong>
                                        @if (isCurrent)
                                        {
                                            <span class="badge bg-primary ms-2">Attivo</span>
                                        }
                                        <div class="text-muted small">@model.Description</div>
                                    </td>
                                    <td><code>@model.FileName</code></td>
                                    <td>~@Math.Round((double)model.ExpectedSizeBytes / (1024*1024*1024), 2) GB</td>
                                    <td><span class="badge bg-secondary">@model.RecommendedRamGb GB</span></td>
                                    <td>~@model.EstimatedMemoryUsageGb GB</td>
                                    <td>
                                        <a href="@model.DownloadUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
                                            🔗 Scheda Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card border shadow-sm">
                <div class="card-header bg-surface-1 py-3">
                    <h5 class="card-title mb-0 fw-semibold">🎨 Modelli Immagini della Famiglia Stable Diffusion</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Modello</th>
                                <th>File Atteso (.gguf)</th>
                                <th>Dimensione</th>
                                <th>RAM Minima</th>
                                <th>Step Default</th>
                                <th>HuggingFace</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var model in AvailableImageModels)
                            {
                                var isCurrent = (Settings.SelectedImageModelKey == model.Key) || 
                                                (Settings.SelectedImageModelKey == AiModelRegistry.AutoModelKey && RecommendedImageModel?.Key == model.Key);
                                <tr class="@(isCurrent ? "table-primary" : "")">
                                    <td>
                                        <strong>@model.DisplayName</strong>
                                        @if (isCurrent)
                                        {
                                            <span class="badge bg-primary ms-2">Attivo</span>
                                        }
                                        <div class="text-muted small">@model.Description</div>
                                    </td>
                                    <td><code>@model.FileName</code></td>
                                    <td>~@Math.Round((double)model.ExpectedSizeBytes / (1024*1024*1024), 2) GB</td>
                                    <td><span class="badge bg-secondary">@model.RecommendedRamGb GB</span></td>
                                    <td><span class="badge bg-info text-dark">@model.DefaultSteps step</span></td>
                                    <td>
                                        <a href="@model.DownloadUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
                                            🔗 Scheda Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AiSettingsDto Settings = new();
    private HardwareProfileDto? HardwareProfile;
    private IReadOnlyList<AiModelDefinition> AvailableTextModels = [];
    private IReadOnlyList<AiModelDefinition> AvailableImageModels = [];
    private AiModelDefinition? RecommendedImageModel;
    private bool IsSaving;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        ModelManager.OnStatusChanged += OnStatusChanged;
        AvailableTextModels = AiModelRegistry.GetTextModels();
        AvailableImageModels = AiModelRegistry.GetImageModels();
        Settings = await AiConfigService.GetSettingsAsync();
        RefreshHardwareProfile();
    }

    private void OnStatusChanged()
    {
        InvokeAsync(() =>
        {
            RefreshHardwareProfile();
            StateHasChanged();
        });
    }

    private void RefreshHardwareProfile()
    {
        var modelsDir = AiConfigService.GetModelsDirectory();
        HardwareProfile = HardwareDetector.GetHardwareProfile(modelsDir);
        var ramBytes = HardwareDetector.GetTotalPhysicalMemoryBytes();
        RecommendedImageModel = AiModelRegistry.ResolveRecommendedImageModel(ramBytes);
    }

    private async Task DownloadActiveModelAsync()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        try
        {
            await ModelManager.EnsureActiveModelReadyAsync(forceDownload: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Errore durante il download del modello testo: {ex.Message}";
        }
    }

    private async Task DownloadActiveImageModelAsync()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        try
        {
            await ModelManager.EnsureActiveImageModelReadyAsync(forceDownload: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Errore durante il download del modello immagini: {ex.Message}";
        }
    }

    private async Task SaveSettingsAsync()
    {
        IsSaving = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            await AiConfigService.SaveSettingsAsync(Settings);
            SuccessMessage = "Impostazioni AI aggiornate con successo.";
            RefreshHardwareProfile();

            if (Settings.IsEnabled)
            {
                _ = ModelManager.EnsureActiveModelReadyAsync(forceDownload: false);
            }
            if (Settings.IsImageGenerationEnabled)
            {
                _ = ModelManager.EnsureActiveImageModelReadyAsync(forceDownload: false);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Errore durante il salvataggio: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    public void Dispose()
    {
        ModelManager.OnStatusChanged -= OnStatusChanged;
    }
}
