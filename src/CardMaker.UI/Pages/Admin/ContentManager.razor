    private bool ShowSymbolSetModal;
    private SaveSymbolSetRequest SymbolSetModel = new() { GameId = Guid.Empty, Key = "", NameIt = "" };

    private bool ShowSymbolModal;
    private Guid CurrentSymbolSetId;
    private SaveSymbolRequest SymbolModel = new() { Key = "", NameIt = "" };

    private bool ShowOptionListModal;
    private SaveOptionListRequest OptionListModel = new() { GameId = Guid.Empty, Key = "", NameIt = "" };

    private bool ShowOptionItemModal;
