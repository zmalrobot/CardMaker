@page "/admin/content"
@attribute [Authorize(Roles = "Admin")]

@inject IAdminContentService ContentService
@inject ITemplateAdminService TemplateService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Gestione Contenuti — CardMaker Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Gestione Contenuti</h1>
        <p class="text-muted mb-0">Configura giochi, tipi di carta, tratti, simboli ed elenchi di opzioni senza modificare il codice.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="admin/audit" class="btn btn-outline-secondary btn-sm">
            <span>📜 Registro Audit</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger shadow-sm mb-3 alert-dismissible fade show" role="alert">
        @ErrorMessage
        <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success shadow-sm mb-3 alert-dismissible fade show" role="alert">
        @SuccessMessage
        <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "games" ? "active" : "")" @onclick="@(() => SetTab("games"))">
            🎮 Giochi (@Games.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "cardtypes" ? "active" : "")" @onclick="@(() => SetTab("cardtypes"))">
            🃏 Tipi di Carta (@CardTypes.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "traits" ? "active" : "")" @onclick="@(() => SetTab("traits"))">
            🏷️ Tratti (@Traits.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "symbols" ? "active" : "")" @onclick="@(() => SetTab("symbols"))">
            🔣 Set di Simboli (@SymbolSets.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "options" ? "active" : "")" @onclick="@(() => SetTab("options"))">
            📋 Liste Opzioni (@OptionLists.Count)
        </button>
    </li>
</ul>

@if (IsLoading)
{
    <div class="p-5 text-center">
        <LoadingSpinner Text="Caricamento catalogo..." />
    </div>
}
else
{
    <!-- 1. TAB GIOCHI -->
    @if (ActiveTab == "games")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold">Giochi Configurate</span>
                <button class="btn btn-primary btn-sm" @onclick="OpenNewGameModal">+ Nuovo Gioco</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Key</th>
                            <th>Nome</th>
                            <th>Formato (mm)</th>
                            <th>DPI</th>
                            <th>Elementi collegati</th>
                            <th>Stato</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Games)
                        {
                            <tr>
                                <td><code>@g.Key</code></td>
                                <td class="fw-semibold">@g.NameIt <span class="text-muted small">(@g.NameEn)</span></td>
                                <td>@g.WidthMm × @g.HeightMm mm <span class="text-muted small">(Bleed: @g.BleedMm mm)</span></td>
                                <td>@g.DefaultDpi</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary-emphasis me-1">@g.CardTypesCount tipi</span>
                                    <span class="badge bg-info-subtle text-info-emphasis me-1">@g.SymbolSetsCount simboli</span>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@g.OptionListsCount opzioni</span>
                                </td>
                                <td>
                                    @if (g.IsPublished)
                                    {
                                        <span class="badge bg-success">Pubblicato</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Bozza</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditGame(g)">Modifica</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteGameAsync(g.Id)">Elimina</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 2. TAB TIPI DI CARTA -->
    @if (ActiveTab == "cardtypes")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">Filtra per Gioco:</span>
                    <select class="form-select form-select-sm w-auto" value="@SelectedGameId" @onchange="OnGameFilterChangedAsync">
                        @foreach (var g in Games)
                        {
                            <option value="@g.Id">@g.NameIt (@g.Key)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="OpenNewCardTypeModal">+ Nuovo Tipo di Carta</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Key</th>
                            <th>Nome</th>
                            <th>Campi definiti</th>
                            <th>Template</th>
                            <th>Tratti ammessi</th>
                            <th>Ordinamento</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in CardTypes)
                        {
                            <tr>
                                <td><code>@ct.Key</code></td>
                                <td class="fw-semibold">@ct.NameIt</td>
                                <td><span class="badge bg-primary">@ct.FieldsCount campi</span></td>
                                <td><span class="badge bg-secondary">@ct.TemplatesCount template</span></td>
                                <td><span class="badge bg-info text-dark">@ct.AllowedTraitsCount tratti</span></td>
                                <td>@ct.SortOrder</td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenTemplatesModalAsync(ct.Id, ct.NameIt)">
                                        🎨 Template (@ct.TemplatesCount)
                                    </button>
                                    <a href="admin/schema/@ct.Id" class="btn btn-primary btn-sm me-1">
                                        ⚡ Schema Campi
                                    </a>
                                    <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => EditCardTypeAsync(ct.Id)">Modifica</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteCardTypeAsync(ct.Id)">Elimina</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 3. TAB TRATTI -->
    @if (ActiveTab == "traits")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">Filtra per Gioco:</span>
                    <select class="form-select form-select-sm w-auto" value="@SelectedGameId" @onchange="OnGameFilterChangedAsync">
                        @foreach (var g in Games)
                        {
                            <option value="@g.Id">@g.NameIt (@g.Key)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="OpenNewTraitModal">+ Nuovo Tratto</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Key</th>
                            <th>Nome</th>
                            <th>Gruppo</th>
                            <th>Ordinamento</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Traits)
                        {
                            <tr>
                                <td><code>@t.Key</code></td>
                                <td class="fw-semibold">@t.NameIt <span class="text-muted small">(@t.NameEn)</span></td>
                                <td><span class="badge bg-secondary">@(string.IsNullOrEmpty(t.Group) ? "Nessuno" : t.Group)</span></td>
                                <td>@t.SortOrder</td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditTrait(t)">Modifica</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTraitAsync(t.Id)">Elimina</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 4. TAB SIMBOLI -->
    @if (ActiveTab == "symbols")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">Filtra per Gioco:</span>
                    <select class="form-select form-select-sm w-auto" value="@SelectedGameId" @onchange="OnGameFilterChangedAsync">
                        @foreach (var g in Games)
                        {
                            <option value="@g.Id">@g.NameIt (@g.Key)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="OpenNewSymbolSetModal">+ Nuovo Set Simboli</button>
            </div>
            <div class="card-body">
                @foreach (var set in SymbolSets)
                {
                    <div class="border rounded p-3 mb-3 bg-surface-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h5 class="mb-0 fw-bold">@set.NameIt <code class="small text-muted">@set.Key</code></h5>
                            </div>
                            <div>
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenAddSymbolModal(set.Id)">+ Aggiungi Simbolo</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteSymbolSetAsync(set.Id)">Elimina Set</button>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sym in set.Symbols)
                            {
                                <div class="badge bg-surface border text-foreground p-2 d-flex align-items-center gap-2">
                                    @if (sym.AssetId.HasValue)
                                    {
                                        <CardMaker.UI.Components.Common.AssetImage AssetId="@sym.AssetId.Value" Alt="@sym.NameIt" Style="width: 20px; height: 20px; object-fit: contain;" />
                                    }
                                    <span>@sym.NameIt (<code>@sym.Key</code>)</span>
                                    <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteSymbolAsync(sym.Id)">×</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 5. TAB LISTE OPZIONI -->
    @if (ActiveTab == "options")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">Filtra per Gioco:</span>
                    <select class="form-select form-select-sm w-auto" value="@SelectedGameId" @onchange="OnGameFilterChangedAsync">
                        @foreach (var g in Games)
                        {
                            <option value="@g.Id">@g.NameIt (@g.Key)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="OpenNewOptionListModal">+ Nuova Lista Opzioni</button>
            </div>
            <div class="card-body">
                @foreach (var list in OptionLists)
                {
                    <div class="border rounded p-3 mb-3 bg-surface-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h5 class="mb-0 fw-bold">@list.NameIt <code class="small text-muted">@list.Key</code></h5>
                            </div>
                            <div>
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenAddOptionItemModal(list.Id)">+ Aggiungi Voce</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteOptionListAsync(list.Id)">Elimina Lista</button>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in list.Items)
                            {
                                <div class="badge bg-surface border text-foreground p-2 d-flex align-items-center gap-2">
                                    <span>@item.LabelIt (<code>@item.Key</code>)</span>
                                    <button class="btn btn-link text-danger p-0 ms-1" @onclick="() => DeleteOptionItemAsync(item.Id)">×</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- MODALI -->
<!-- Modale Gioco -->
@if (ShowGameModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(GameModel.Id.HasValue ? "Modifica Gioco" : "Nuovo Gioco")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowGameModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Key (univoca)</label>
                        <input type="text" class="form-control form-control-sm" @bind="GameModel.Key" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (IT)</label>
                            <input type="text" class="form-control form-control-sm" @bind="GameModel.NameIt" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (EN)</label>
                            <input type="text" class="form-control form-control-sm" @bind="GameModel.NameEn" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Larghezza (mm)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="GameModel.WidthMm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Altezza (mm)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="GameModel.HeightMm" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Bleed (mm)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="GameModel.BleedMm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Safe Zone (mm)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="GameModel.SafeZoneMm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Raggio (mm)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="GameModel.CornerRadiusMm" />
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="pubSwitch" @bind="GameModel.IsPublished" />
                        <label class="form-check-label small fw-semibold" for="pubSwitch">Pubblica gioco agli utenti</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowGameModal = false">Annulla</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveGameAsync">Salva</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modale Tipo Carta -->
@if (ShowCardTypeModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(CardTypeModel.Id.HasValue ? "Modifica Tipo Carta" : "Nuovo Tipo Carta")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowCardTypeModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Key (univoca)</label>
                        <input type="text" class="form-control form-control-sm" @bind="CardTypeModel.Key" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (IT)</label>
                            <input type="text" class="form-control form-control-sm" @bind="CardTypeModel.NameIt" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (EN)</label>
                            <input type="text" class="form-control form-control-sm" @bind="CardTypeModel.NameEn" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Ordinamento</label>
                        <input type="number" class="form-control form-control-sm" @bind="CardTypeModel.SortOrder" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowCardTypeModal = false">Annulla</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCardTypeAsync">Salva</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modale Gestione Template Tipo Carta -->
@if (ShowTemplatesModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">🎨 Template di @TemplatesModalCardTypeName</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowTemplatesModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Configura e disegna il layout visivo nel Template Studio WYSIWYG.</span>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNewTemplateAsync">+ Nuovo Template</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Key</th>
                                    <th>Nome</th>
                                    <th>Versioni</th>
                                    <th>Pubblicata</th>
                                    <th>Default</th>
                                    <th class="text-end">Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (TemplatesList.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="p-4 text-center text-muted">
                                            Nessun template configurato per questo tipo di carta.
                                        </td>
                                    </tr>
                                }
                                @foreach (var t in TemplatesList)
                                {
                                    <tr>
                                        <td><code>@t.Key</code></td>
                                        <td class="fw-semibold">@t.Name</td>
                                        <td><span class="badge bg-secondary">@t.VersionsCount ver</span></td>
                                        <td>
                                            @if (t.LatestPublishedVersionNumber.HasValue)
                                            {
                                                <span class="badge bg-success">v@t.LatestPublishedVersionNumber</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Nessuna</span>
                                            }
                                        </td>
                                        <td>
                                            @if (t.IsDefault)
                                            {
                                                <span class="badge bg-primary">Default</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="admin/templates/@t.Id" class="btn btn-primary btn-sm me-1">
                                                🎨 Studio WYSIWYG
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTemplateAsync(t.Id)">
                                                Elimina
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowTemplatesModal = false">Chiudi</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modale Tratto -->
@if (ShowTraitModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(TraitModel.Id.HasValue ? "Modifica Tratto" : "Nuovo Tratto")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowTraitModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Key (univoca)</label>
                        <input type="text" class="form-control form-control-sm" @bind="TraitModel.Key" placeholder="es. spellcaster, dragon..." />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (IT)</label>
                            <input type="text" class="form-control form-control-sm" @bind="TraitModel.NameIt" placeholder="es. Incantatore" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Nome (EN)</label>
                            <input type="text" class="form-control form-control-sm" @bind="TraitModel.NameEn" placeholder="es. Spellcaster" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Gruppo (opzionale)</label>
                        <input type="text" class="form-control form-control-sm" @bind="TraitModel.Group" placeholder="es. Tipo, Attributo..." />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Ordinamento</label>
                        <input type="number" class="form-control form-control-sm" @bind="TraitModel.SortOrder" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowTraitModal = false">Annulla</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveTraitAsync">Salva</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modale Set di Simboli -->
@if (ShowSymbolSetModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(SymbolSetModel.Id.HasValue ? "Modifica Set Simboli" : "Nuovo Set Simboli")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowSymbolSetModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Key (univoca)</label>
