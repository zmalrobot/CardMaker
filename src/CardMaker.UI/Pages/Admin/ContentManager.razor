            HeightMm = 86m,
            BleedMm = 2m,
            SafeZoneMm = 3m,
            CornerRadiusMm = 2m,
            DefaultDpi = 600,
            IsPublished = true,
        };
        ShowGameModal = true;
    }

    private void EditGame(AdminGameDto g)
    {
        GameModel = new SaveGameRequest
        {
            Id = g.Id,
            Key = g.Key,
            NameIt = g.NameIt,
            NameEn = g.NameEn,
            DescriptionIt = g.DescriptionIt,
            DescriptionEn = g.DescriptionEn,
            WidthMm = g.WidthMm,
            HeightMm = g.HeightMm,
            BleedMm = g.BleedMm,
            SafeZoneMm = g.SafeZoneMm,
            CornerRadiusMm = g.CornerRadiusMm,
            DefaultDpi = g.DefaultDpi,
            IsPublished = g.IsPublished,
            SortOrder = g.SortOrder,
        };
        ShowGameModal = true;
    }

    private async Task SaveGameAsync()
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            await ContentService.SaveGameAsync(GameModel, uid);
            ShowGameModal = false;
            SuccessMessage = "Gioco salvato con successo!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DeleteGameAsync(Guid id)
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            await ContentService.DeleteGameAsync(id, uid);
            SuccessMessage = "Gioco eliminato!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

