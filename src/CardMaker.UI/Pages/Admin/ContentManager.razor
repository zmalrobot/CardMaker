@page "/admin/content"
@attribute [Authorize(Roles = "Admin")]

@using CardMaker.Application.Admin
@using CardMaker.UI.Pages.Admin.ContentTabs

@inject IAdminContentService ContentService

<PageTitle>Gestione Contenuti — CardMaker Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Gestione Contenuti</h1>
        <p class="text-muted mb-0">Configura giochi, tipi di carta, tratti, simboli ed elenchi di opzioni senza modificare il codice.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="admin/audit" class="btn btn-outline-secondary btn-sm">
            <span>📜 Registro Audit</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger shadow-sm mb-3 alert-dismissible fade show" role="alert">
        @ErrorMessage
        <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success shadow-sm mb-3 alert-dismissible fade show" role="alert">
        @SuccessMessage
        <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "games" ? "active" : "")" @onclick="@(() => SetTab("games"))">
            🎮 Giochi (@Games.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "cardtypes" ? "active" : "")" @onclick="@(() => SetTab("cardtypes"))">
            🃏 Tipi di Carta (@CardTypes.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "traits" ? "active" : "")" @onclick="@(() => SetTab("traits"))">
            🏷️ Tratti (@Traits.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "symbols" ? "active" : "")" @onclick="@(() => SetTab("symbols"))">
            🔣 Set di Simboli (@SymbolSets.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(ActiveTab == "options" ? "active" : "")" @onclick="@(() => SetTab("options"))">
            📋 Liste Opzioni (@OptionLists.Count)
        </button>
    </li>
</ul>

@if (IsLoading)
{
    <div class="p-5 text-center">
        <LoadingSpinner Text="Caricamento catalogo..." />
    </div>
}
else
{
    @if (ActiveTab == "games")
    {
        <GamesTab Games="Games"
                  OnChanged="LoadDataAsync"
                  OnSuccess="msg => SuccessMessage = msg"
                  OnError="msg => ErrorMessage = msg" />
    }
    else if (ActiveTab == "cardtypes")
    {
        <CardTypesTab Games="Games"
                      SelectedGameId="SelectedGameId"
                      CardTypes="CardTypes"
                      OnGameSelected="OnGameSelectedAsync"
                      OnChanged="LoadGameSubEntitiesAsync"
                      OnSuccess="msg => SuccessMessage = msg"
                      OnError="msg => ErrorMessage = msg" />
    }
    else if (ActiveTab == "traits")
    {
        <TraitsTab Games="Games"
                   SelectedGameId="SelectedGameId"
                   Traits="Traits"
                   OnGameSelected="OnGameSelectedAsync"
                   OnChanged="LoadGameSubEntitiesAsync"
                   OnSuccess="msg => SuccessMessage = msg"
                   OnError="msg => ErrorMessage = msg" />
    }
    else if (ActiveTab == "symbols")
    {
        <SymbolSetsTab Games="Games"
                       SelectedGameId="SelectedGameId"
                       SymbolSets="SymbolSets"
                       OnGameSelected="OnGameSelectedAsync"
                       OnChanged="LoadGameSubEntitiesAsync"
                       OnSuccess="msg => SuccessMessage = msg"
                       OnError="msg => ErrorMessage = msg" />
    }
    else if (ActiveTab == "options")
    {
        <OptionListsTab Games="Games"
                        SelectedGameId="SelectedGameId"
                        OptionLists="OptionLists"
                        OnGameSelected="OnGameSelectedAsync"
                        OnChanged="LoadGameSubEntitiesAsync"
                        OnSuccess="msg => SuccessMessage = msg"
                        OnError="msg => ErrorMessage = msg" />
    }
}

@code {
    private string ActiveTab = "games";
    private bool IsLoading = true;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private IReadOnlyList<AdminGameDto> Games = [];
    private IReadOnlyList<AdminCardTypeDto> CardTypes = [];
    private IReadOnlyList<AdminTraitDto> Traits = [];
    private IReadOnlyList<AdminSymbolSetDto> SymbolSets = [];
    private IReadOnlyList<AdminOptionListDto> OptionLists = [];

    private Guid SelectedGameId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            Games = await ContentService.GetGamesAsync();
            if (Games.Count > 0 && (SelectedGameId == Guid.Empty || !Games.Any(g => g.Id == SelectedGameId)))
            {
                SelectedGameId = Games[0].Id;
            }

            if (SelectedGameId != Guid.Empty)
            {
                await LoadGameSubEntitiesAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadGameSubEntitiesAsync()
    {
        CardTypes = await ContentService.GetCardTypesAsync(SelectedGameId);
        Traits = await ContentService.GetTraitsAsync(SelectedGameId);
        SymbolSets = await ContentService.GetSymbolSetsAsync(SelectedGameId);
        OptionLists = await ContentService.GetOptionListsAsync(SelectedGameId);
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private async Task OnGameSelectedAsync(Guid gameId)
    {
        SelectedGameId = gameId;
        await LoadGameSubEntitiesAsync();
    }
}
