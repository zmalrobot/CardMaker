    private IReadOnlyList<AdminTraitDto> Traits = [];
    private IReadOnlyList<AdminSymbolSetDto> SymbolSets = [];
    private IReadOnlyList<AdminOptionListDto> OptionLists = [];

    private Guid SelectedGameId;

    // Modals state
    private bool ShowGameModal;
    private SaveGameRequest GameModel = new() { Key = "", NameIt = "" };

    private bool ShowCardTypeModal;
    private SaveCardTypeRequest CardTypeModel = new() { GameId = Guid.Empty, Key = "", NameIt = "" };

    private bool ShowTemplatesModal;
    private Guid TemplatesModalCardTypeId;
    private string TemplatesModalCardTypeName = "";
