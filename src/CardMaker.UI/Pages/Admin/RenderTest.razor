@page "/admin/render-test"
@attribute [Authorize(Roles = "Admin")]

@using CardMaker.Application.Admin
@inject ICardPreviewService Preview
@inject IAssetCatalog Catalog
@inject IAdminContentService ContentService
@inject AuthenticationStateProvider AuthProvider
@inject CardMaker.Application.Common.ILoadingService LoadingService

<PageTitle>Prova Motore — CardMaker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Prova del Motore di Rendering</h1>
        <p class="text-muted mb-0">
            Renderizza un layout con lo stesso codice server-side usato per l'export ad alta risoluzione.
            Verifica auto-fit, compressione orizzontale, font di gioco, artwork e simboli.
        </p>
    </div>
</div>

<TwoColumnLayout>
    <FormContent>
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">Parametri Carta di Prova</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold" for="game">Gioco di Riferimento</label>
                    <select id="game" class="form-select" @bind="_selectedGameId" @bind:after="OnGameChanged">
                        @foreach (var g in _games)
                        {
                            <option value="@g.Id.ToString()">@g.NameIt</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Illustrazione (Artwork)</label>
                    <InputFile OnChange="OnArtworkSelectedAsync" class="form-control" accept="image/*" />
                    <div class="form-text small">Carica un'immagine per collaudare il ritaglio e la risoluzione dell'artwork.</div>
                    @if (_artworkAssetId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mt-2 p-2 border rounded bg-surface-2">
                            <CardMaker.UI.Components.Common.AssetImage AssetId="@_artworkAssetId.Value" Class="rounded border" Style="height:45px; width:45px; object-fit:cover;" />
                            <span class="small text-success flex-grow-1 text-truncate">@_artworkFileName</span>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearArtwork">Rimuovi</button>
                        </div>
                    }
                </div>

                @if (IsMtg)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold" for="mtgName">Nome Carta</label>
                            <input id="mtgName" class="form-control" @bind="_mtgName" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="mtgMana">Costo di Mana</label>
                            <input id="mtgMana" class="form-control" @bind="_mtgManaCost" @bind:event="oninput" placeholder="{3}{W}{W}" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold" for="mtgType">Riga del Tipo</label>
                            <input id="mtgType" class="form-control" @bind="_mtgTypeLine" @bind:event="oninput" placeholder="Creatura — Angelo" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="mtgRarity">Rarità</label>
                            <select id="mtgRarity" class="form-select" @bind="_mtgRarity">
                                <option value="common">Comune</option>
                                <option value="uncommon">Non Comune</option>
                                <option value="rare">Rara</option>
                                <option value="mythic">Rara Mitica</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="mtgRules">Testo delle Regole</label>
                        <textarea id="mtgRules" class="form-control" rows="3" @bind="_mtgRules" @bind:event="oninput"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="mtgFlavor">Testo di Colore (Flavor Text)</label>
                        <textarea id="mtgFlavor" class="form-control" rows="2" @bind="_mtgFlavor" @bind:event="oninput"></textarea>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-3">
                            <label class="form-label small fw-semibold" for="mtgPower">Forza</label>
                            <input id="mtgPower" class="form-control" @bind="_mtgPower" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-semibold" for="mtgToughness">Costituzione</label>
                            <input id="mtgToughness" class="form-control" @bind="_mtgToughness" @bind:event="oninput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="dpi">DPI</label>
                            <select id="dpi" class="form-select" @bind="_dpi">
                                <option value="96">96 DPI (Bozza)</option>
                                <option value="150">150 DPI (Anteprima)</option>
                                <option value="300">300 DPI</option>
                                <option value="600">600 DPI (Export)</option>
                            </select>
                        </div>
                    </div>

                    <div class="card bg-surface-2 border-0 mb-3">
                        <div class="card-header bg-transparent py-1 px-2 border-0">
                            <span class="small fw-bold text-uppercase text-secondary">Piè di pagina e Metadati</span>
                        </div>
                        <div class="card-body p-2">
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="mtgCollector">Numero Collettore</label>
                                    <input id="mtgCollector" class="form-control form-control-sm" @bind="_mtgCollectorNumber" @bind:event="oninput" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="mtgIllus">Illustratore</label>
                                    <input id="mtgIllus" class="form-control form-control-sm" @bind="_mtgIllustrator" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold" for="mtgCopy">Copyright</label>
                                    <input id="mtgCopy" class="form-control form-control-sm" @bind="_mtgCopyright" @bind:event="oninput" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (IsPokemon)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold" for="pkmnName">Nome Pokémon</label>
                            <input id="pkmnName" class="form-control" @bind="_pkmnName" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="pkmnStage">Fase</label>
                            <select id="pkmnStage" class="form-select" @bind="_pkmnStage">
                                <option value="BASE">BASE</option>
                                <option value="FASE 1">FASE 1</option>
                                <option value="FASE 2">FASE 2</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="pkmnHp">Punti Salute (HP)</label>
                            <input id="pkmnHp" class="form-control" @bind="_pkmnHp" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="pkmnEnergy">Tipo Energia</label>
                            <select id="pkmnEnergy" class="form-select" @bind="_pkmnEnergy">
                                <option value="lightning">Lampo ⚡</option>
                                <option value="fire">Fuoco 🔥</option>
                                <option value="water">Acqua 💧</option>
                                <option value="grass">Erba 🌿</option>
                                <option value="psychic">Psico 👁</option>
                                <option value="fighting">Lotta 👊</option>
                                <option value="darkness">Oscurità 🌙</option>
                                <option value="metal">Metallo ⚙</option>
                                <option value="fairy">Folletto ✨</option>
                                <option value="dragon">Drago 🐲</option>
                                <option value="colorless">Incolore ✴</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="dpi">DPI</label>
                            <select id="dpi" class="form-select" @bind="_dpi">
                                <option value="96">96 DPI (Bozza)</option>
                                <option value="150">150 DPI (Anteprima)</option>
                                <option value="300">300 DPI</option>
                                <option value="600">600 DPI (Export)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="pkmnPokedex">Info Pokédex (Sottotitolo)</label>
                        <input id="pkmnPokedex" class="form-control form-control-sm" @bind="_pkmnPokedex" @bind:event="oninput" />
                    </div>

                    <div class="card mb-3 bg-surface-2 border">
                        <div class="card-header py-1 px-3 fw-semibold small">Attacco 1</div>
                        <div class="card-body p-2">
                            <div class="row g-2 mb-2">
                                <div class="col-8">
                                    <input class="form-control form-control-sm" @bind="_pkmnAtk1Name" @bind:event="oninput" placeholder="Nome Attacco 1" />
                                </div>
                                <div class="col-4">
                                    <input class="form-control form-control-sm" @bind="_pkmnAtk1Dmg" @bind:event="oninput" placeholder="Danno (es. 10)" />
                                </div>
                            </div>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_pkmnAtk1Effect" @bind:event="oninput" placeholder="Effetto attacco 1..."></textarea>
                        </div>
                    </div>

                    <div class="card mb-3 bg-surface-2 border">
                        <div class="card-header py-1 px-3 fw-semibold small">Attacco 2</div>
                        <div class="card-body p-2">
                            <div class="row g-2 mb-2">
                                <div class="col-8">
                                    <input class="form-control form-control-sm" @bind="_pkmnAtk2Name" @bind:event="oninput" placeholder="Nome Attacco 2" />
                                </div>
                                <div class="col-4">
                                    <input class="form-control form-control-sm" @bind="_pkmnAtk2Dmg" @bind:event="oninput" placeholder="Danno (es. 50)" />
                                </div>
                            </div>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_pkmnAtk2Effect" @bind:event="oninput" placeholder="Effetto attacco 2..."></textarea>
                        </div>
                    </div>

                    <div class="card mb-3 bg-surface-2 border">
                        <div class="card-header py-1 px-3 fw-semibold small">Debolezza, Ritirata e Dettagli</div>
                        <div class="card-body p-2">
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <label class="form-label small fw-semibold">Debolezza</label>
                                    <select class="form-select form-select-sm" @bind="_pkmnWeakness">
                                        <option value="fighting">Lotta 👊</option>
                                        <option value="fire">Fuoco 🔥</option>
                                        <option value="water">Acqua 💧</option>
                                        <option value="lightning">Lampo ⚡</option>
                                        <option value="grass">Erba 🌿</option>
                                        <option value="psychic">Psico 👁</option>
                                        <option value="darkness">Oscurità 🌙</option>
                                        <option value="metal">Metallo ⚙</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-semibold">Valore Deb.</label>
                                    <input class="form-control form-control-sm" @bind="_pkmnWeaknessVal" @bind:event="oninput" placeholder="es. ×2" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-semibold">Costo Ritirata</label>
                                    <input class="form-control form-control-sm" @bind="_pkmnRetreat" @bind:event="oninput" placeholder="0-4" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Descrizione Pokédex (Flavor)</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_pkmnFlavor" @bind:event="oninput"></textarea>
                            </div>
                            <div class="row g-2">
                                <div class="col-4">
                                    <input class="form-control form-control-sm" @bind="_pkmnIllustrator" @bind:event="oninput" placeholder="Illustratore" />
                                </div>
                                <div class="col-4">
                                    <input class="form-control form-control-sm" @bind="_pkmnCardNum" @bind:event="oninput" placeholder="025/102" />
                                </div>
                                <div class="col-4">
                                    <input class="form-control form-control-sm" @bind="_pkmnCopyright" @bind:event="oninput" placeholder="Copyright" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold" for="name">Nome carta</label>
                            <input id="name" class="form-control" @bind="_name" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="effectFlag">Categoria</label>
                            <select id="effectFlag" class="form-select" @bind="_effectFlag">
                                <option value="Normale">Normale</option>
                                <option value="Effetto">Effetto</option>
                                <option value="Tuner">Tuner</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="race">Tipo / Razza</label>
                            <input id="race" class="form-control" @bind="_race" @bind:event="oninput" placeholder="es. Drago, Guerriero..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold" for="summon">Metodo evocazione</label>
                            <select id="summon" class="form-select" @bind="_summonMethod">
                                <option value="">(Nessuno)</option>
                                <option value="Synchro">Synchro</option>
                                <option value="Link">Link (Nasconde DEF)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="effect">Testo effetto / Descrizione</label>
                        <textarea id="effect" class="form-control" rows="4" @bind="_effect" @bind:event="oninput"></textarea>
                        <div class="form-text small">Aggiungi testo o descrizione per osservare l'auto-fit ridurre corpo e interlinea.</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="atk">ATK</label>
                            <input id="atk" class="form-control" @bind="_atk" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="def">DEF</label>
                            <input id="def" class="form-control" @bind="_def" @bind:event="oninput" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold" for="dpi">Risoluzione DPI</label>
                            <select id="dpi" class="form-select" @bind="_dpi">
                                <option value="96">96 DPI (Bozza)</option>
                                <option value="150">150 DPI (Anteprima)</option>
                                <option value="300">300 DPI</option>
                                <option value="600">600 DPI (Export)</option>
                            </select>
                        </div>
                    </div>

                    <div class="card mb-3 bg-surface-2 border">
                        <div class="card-header py-1 px-3 fw-semibold small">Dettagli Carta, Codici &amp; Versione</div>
                        <div class="card-body p-2">
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="setCode">Codice Set / Numero</label>
                                    <input id="setCode" class="form-control form-control-sm" @bind="_setCode" @bind:event="oninput" placeholder="es. LOB-IT001" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="edition">Edizione / Versione</label>
                                    <input id="edition" class="form-control form-control-sm" @bind="_edition" @bind:event="oninput" placeholder="es. 1ª EDIZIONE" />
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-5">
                                    <label class="form-label small fw-semibold" for="passcode">Numero Seriale / Passcode</label>
                                    <input id="passcode" class="form-control form-control-sm" @bind="_passcode" @bind:event="oninput" placeholder="es. 89631139" />
                                </div>
                                <div class="col-7">
                                    <label class="form-label small fw-semibold" for="copyright">Copyright / Info legali</label>
                                    <input id="copyright" class="form-control form-control-sm" @bind="_copyright" @bind:event="oninput" placeholder="es. ©2020 Studio Dice..." />
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="guides" @bind="_showGuides" />
                    <label class="form-check-label small" for="guides">Guide di trim e safe zone</label>
                </div>

                <button class="btn btn-primary w-100 py-2 fw-semibold" @onclick="RenderAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Render in corso...</span>
                    }
                    else
                    {
                        <span>Renderizza Carta</span>
                    }
                </button>
            </div>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger shadow-sm">
                <strong>Attenzione:</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </FormContent>

    <PreviewContent>
        <CardPreview ImageSrc="@_imageData"
                     IsLoading="@_busy"
                     Warnings="@_warnings"
                     WidthPx="@_width"
                     HeightPx="@_height"
                     Dpi="@_dpi"
                     Duration="@(TimeSpan.FromMilliseconds(_elapsed))" />
    </PreviewContent>
</TwoColumnLayout>

@code {
    private IReadOnlyList<AdminGameDto> _games = [];
    private string _selectedGameId = string.Empty;

    private Guid? _artworkAssetId;
    private string _artworkFileName = string.Empty;

    // Yu-Gi-Oh fields
    private string _name = "Drago Bianco Occhi Blu";
    private string _race = "Drago";
    private string _effectFlag = "Normale";
    private string _effect = DemoLayouts.SampleValues()["effectText"].AsText();
    private string _atk = "3000";
    private string _def = "2500";
    private string _setCode = "LOB-IT001";
    private string _edition = "1ª EDIZIONE";
    private string _passcode = "89631139";
    private string _copyright = "©2020 Studio Dice/SHUEISHA, TV TOKYO, KONAMI";
    private string _summonMethod = string.Empty;

    // Pokémon fields
    private string _pkmnName = "Pikachu";
    private string _pkmnStage = "BASE";
    private string _pkmnHp = "60";
    private string _pkmnEnergy = "lightning";
    private string _pkmnPokedex = "NO. 025  Pokémon Topo  Alt: 0.4 m  Peso: 6.0 kg";
    private string _pkmnAtk1Name = "Carica Lampo";
    private string _pkmnAtk1Dmg = "10";
    private string _pkmnAtk1Effect = "Lancia una moneta. Se esce testa, questo attacco infligge 10 danni in più.";
    private string _pkmnAtk2Name = "Fulmine";
    private string _pkmnAtk2Dmg = "50";
    private string _pkmnAtk2Effect = "Scarta tutte le Energie assegnate a questo Pokémon.";
    private string _pkmnWeakness = "fighting";
    private string _pkmnWeaknessVal = "×2";
    private string _pkmnRetreat = "1";
    private string _pkmnFlavor = "Quando si riuniscono molti di questi Pokémon, la loro elettricità può accumularsi e creare improvvisi temporali.";
    private string _pkmnIllustrator = "Illus. Ken Sugimori";
    private string _pkmnCardNum = "025/102";
    private string _pkmnCopyright = "©2024 Pokémon / Nintendo / Creatures / GAME FREAK";

    // Magic fields
    private string _mtgName = "Angelo Serra";
    private string _mtgManaCost = "{3}{W}{W}";
    private string _mtgTypeLine = "Creatura — Angelo";
    private string _mtgRules = "Volare, cautela (Questa creatura attacca senza TAPpare.)";
    private string _mtgFlavor = "Nata con ali di luce e una spada di vendetta, non conosce paura né perdono.";
    private string _mtgPower = "4";
    private string _mtgToughness = "4";
    private string _mtgRarity = "rare";
    private string _mtgCollectorNumber = "023/280";
    private string _mtgIllustrator = "Douglas Shuler";
    private string _mtgCopyright = "™ & © 2024 Wizards of the Coast";

    private int _dpi = 150;
    private bool _showGuides;
    private bool _busy;

    private string? _imageData;
    private int _width;
    private int _height;
    private double _elapsed;
    private IReadOnlyList<PreviewWarning> _warnings = [];
    private IReadOnlyList<string> _errors = [];

    private bool IsMtg => _games.FirstOrDefault(g => g.Id.ToString() == _selectedGameId)?.Key == "mtg";
    private bool IsPokemon => _games.FirstOrDefault(g => g.Id.ToString() == _selectedGameId)?.Key == "pokemon";

    protected override async Task OnInitializedAsync()
    {
        _games = await ContentService.GetGamesAsync();
        if (_games.Count > 0)
        {
            _selectedGameId = _games[0].Id.ToString();
        }

        await RenderAsync();
    }

    private async Task OnGameChanged()
    {
        await RenderAsync();
    }

    private async Task OnArtworkSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _busy = true;
        _errors = [];
        StateHasChanged();

        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            Guid? gameId = Guid.TryParse(_selectedGameId, out var gid) ? gid : null;

            await using var stream = file.OpenReadStream(20L * 1024 * 1024);
            var outcome = await Catalog.UploadAsync(stream, new AssetUploadRequest
            {
                FileName = file.Name,
                Category = AssetCategory.Artwork,
                LicenseNote = "Artwork di prova per test del motore di rendering.",
                UploadedByUserId = userId,
                GameId = gameId,
                Kind = UploadKind.Image,
            });

            if (outcome.Succeeded && outcome.Asset is not null)
            {
                _artworkAssetId = outcome.Asset.Id;
                _artworkFileName = file.Name;
                await RenderAsync();
            }
            else
            {
                _errors = [$"Caricamento immagine fallito: {outcome.ErrorCode}"];
            }
        }
        catch (Exception ex)
        {
            _errors = [$"Errore durante il caricamento dell'immagine: {ex.Message}"];
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ClearArtwork()
    {
        _artworkAssetId = null;
        _artworkFileName = string.Empty;
        await RenderAsync();
    }

    private async Task RenderAsync()
    {
        _busy = true;
        _errors = [];
        StateHasChanged();

        using (await LoadingService.BeginScopeAsync($"Rendering carta a {_dpi} DPI in corso..."))
        {
            try
            {
                Guid? gameId = Guid.TryParse(_selectedGameId, out var gid) ? gid : null;
                CardPreviewResult result;

                if (IsMtg)
                {
                    var values = DemoLayouts.MtgSampleValues();
                    values["name"] = CardValue.FromText(_mtgName);
                    values["manaCost"] = CardValue.FromText(_mtgManaCost);
                    values["typeLine"] = CardValue.FromText(_mtgTypeLine);
                    values["rulesText"] = CardValue.FromText(_mtgRules);
                    values["flavorText"] = CardValue.FromText(_mtgFlavor);
                    values["power"] = CardValue.FromText(_mtgPower);
                    values["toughness"] = CardValue.FromText(_mtgToughness);
                    values["setRarity"] = CardValue.FromText(_mtgRarity);
                    values["collectorNumber"] = CardValue.FromText(_mtgCollectorNumber);
                    values["illustrator"] = CardValue.FromText(_mtgIllustrator);
                    values["copyright"] = CardValue.FromText(_mtgCopyright);

                    if (_artworkAssetId.HasValue)
                    {
                        values["artwork"] = CardValue.FromText(_artworkAssetId.Value.ToString());
                    }

                    result = await Preview.RenderAsync(new CardPreviewRequest
                    {
                        LayoutJson = LayoutSerializer.Serialize(DemoLayouts.MtgCreature()),
                        Values = values,
                        GameId = gameId,
                        Dpi = _dpi,
                        ShowGuides = _showGuides,
                    });
                }
                else if (IsPokemon)
                {
                    var values = DemoLayouts.PokemonSampleValues();
                    values["name"] = CardValue.FromText(_pkmnName);
                    values["stage"] = CardValue.FromText(_pkmnStage);
                    values["hp"] = CardValue.FromText(_pkmnHp);
                    values["energyType"] = CardValue.FromText(_pkmnEnergy);
                    values["pokedexEntry"] = CardValue.FromText(_pkmnPokedex);
                    values["attack1Name"] = CardValue.FromText(_pkmnAtk1Name);
                    values["attack1Damage"] = CardValue.FromText(_pkmnAtk1Dmg);
                    values["attack1Effect"] = CardValue.FromText(_pkmnAtk1Effect);
                    values["attack2Name"] = CardValue.FromText(_pkmnAtk2Name);
                    values["attack2Damage"] = CardValue.FromText(_pkmnAtk2Dmg);
                    values["attack2Effect"] = CardValue.FromText(_pkmnAtk2Effect);
                    values["weakness"] = CardValue.FromText(_pkmnWeakness);
                    values["weaknessValue"] = CardValue.FromText(_pkmnWeaknessVal);
                    values["retreatCost"] = CardValue.FromText(_pkmnRetreat);
                    values["flavorText"] = CardValue.FromText(_pkmnFlavor);
                    values["illustrator"] = CardValue.FromText(_pkmnIllustrator);
                    values["cardNumber"] = CardValue.FromText(_pkmnCardNum);
                    values["copyright"] = CardValue.FromText(_pkmnCopyright);

                    if (_artworkAssetId.HasValue)
                    {
                        values["artwork"] = CardValue.FromText(_artworkAssetId.Value.ToString());
                    }

                    result = await Preview.RenderAsync(new CardPreviewRequest
                    {
                        LayoutJson = LayoutSerializer.Serialize(DemoLayouts.PokemonBasic()),
                        Values = values,
                        GameId = gameId,
                        Dpi = _dpi,
                        ShowGuides = _showGuides,
                    });
                }
                else
                {
                    var values = DemoLayouts.SampleValues();
                    values["name"] = CardValue.FromText(_name);
                    values["race"] = CardValue.FromText(_race);
                    values["effectFlag"] = CardValue.FromText(_effectFlag);
                    values["effectText"] = CardValue.FromText(_effect);
                    values["atk"] = CardValue.FromText(_atk);
                    values["def"] = CardValue.FromText(_def);
                    values["setCode"] = CardValue.FromText(_setCode);
                    values["edition"] = CardValue.FromText(_edition);
                    values["passcode"] = CardValue.FromText(_passcode);
                    values["copyright"] = CardValue.FromText(_copyright);
                    values["summonMethod"] = CardValue.FromText(_summonMethod);

                    if (_artworkAssetId.HasValue)
                    {
                        values["artwork"] = CardValue.FromText(_artworkAssetId.Value.ToString());
                    }

                    result = await Preview.RenderAsync(new CardPreviewRequest
                    {
                        LayoutJson = LayoutSerializer.Serialize(DemoLayouts.YuGiOhMonster()),
                        Values = values,
                        GameId = gameId,
                        Dpi = _dpi,
                        ShowGuides = _showGuides,
                    });
                }

                _errors = result.Errors;
                _warnings = result.Warnings;

                if (result.Succeeded && result.Content is not null)
                {
                    _imageData = $"data:{result.ContentType};base64,{Convert.ToBase64String(result.Content)}";
                    _width = result.WidthPx;
                    _height = result.HeightPx;
                    _elapsed = result.ElapsedMs;
                }
            }
            catch (Exception ex)
            {
                _errors = [$"Errore durante il rendering: {ex.Message}"];
            }
            finally
            {
                _busy = false;
                StateHasChanged();
            }
        }
    }
}
