@page "/admin/backups"
@attribute [Authorize(Roles = "Admin")]
@using CardMaker.Application.Admin
@using CardMaker.Application.Common
@inject IBackupService BackupService
@inject IDatabaseResetService DatabaseResetService
@inject ILoadingService LoadingService

<PageTitle>Backup & Integrità — CardMaker Admin</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">💾 Backup & Integrità SQLite</h1>
            <p class="text-muted mb-0">Gestione snapshot atomici online via <code>VACUUM INTO</code> e test periodico di integrità del database.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="VerifyIntegrity" disabled="@IsProcessing">
                <span>🔍 Verifica Integrità</span>
            </button>
            <button class="btn btn-primary" @onclick="TakeSnapshot" disabled="@IsProcessing">
                <span>📸 Esegui Snapshot Database</span>
            </button>
        </div>
    </div>

    @if (SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <span>@SuccessMessage</span>
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (IntegrityReport != null)
    {
        <div class="card border shadow-sm mb-4">
            <div class="card-header bg-surface-1 py-3 d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0 fw-semibold">Rapporto Integrità SQLite (PRAGMA integrity_check)</h5>
                <span class="badge @(IntegrityReport.IsHealthy ? "bg-success" : "bg-danger") fs-6">
                    @(IntegrityReport.IsHealthy ? "Database Integro" : "Attenzione: Problemi Rilevati")
                </span>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-1">@(IntegrityReport.IsHealthy ? "✅" : "⚠️")</span>
                    <div>
                        <div class="fw-semibold">Esito Verifica: <code>@IntegrityReport.CheckResult</code></div>
                        <small class="text-muted">Eseguito il: @IntegrityReport.CheckedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card border shadow-sm">
        <div class="card-header bg-surface-1 py-3">
            <h5 class="card-title mb-0 fw-semibold">Snapshot Salvati</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome File Snapshot</th>
                        <th>Dimensione</th>
                        <th>Data Creazione (UTC)</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Backups.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Nessuno snapshot presente nella cartella dati.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Backups)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace">@b.FileName</td>
                                <td>@FormatBytes(b.SizeBytes)</td>
                                <td>@b.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBackup(b.FileName)" disabled="@IsProcessing">
                                        Elimina
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ZONA PERICOLO / FACTORY RESET -->
    <div class="card border-danger shadow-sm mt-5 mb-4">
        <div class="card-header bg-danger text-white py-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">⚠️</span>
                <h5 class="card-title mb-0 fw-bold">ZONA PERICOLO — RIPRISTINO DI FABBRICA DATABASE</h5>
            </div>
            <span class="badge bg-dark text-white text-uppercase px-2 py-1">Azione Distruttiva</span>
        </div>
        <div class="card-body bg-danger-subtle text-danger-emphasis p-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h5 class="fw-bold mb-2">💥 Ripristino Completo allo Stato Iniziale</h5>
                    <p class="mb-2">
                        Questa operazione è <strong>completamente irreversibile</strong>. Il database corrente verrà cancellato e rigenerato da zero.
                    </p>
                    <ul class="small mb-0 ps-3">
                        <li><strong>Cancellazione totale</strong> di tutte le carte create, bozze e asset caricati.</li>
                        <li><strong>Ricreazione dello schema</strong> ed esecuzione automatica delle migrazioni EF Core.</li>
                        <li><strong>Re-seeding completo di fabbrica</strong>: tutti i set e giochi ufficiali (Yu-Gi-Oh!, Pokémon, Magic: The Gathering), tutti i template e ruoli font ufficiali verranno ripristinati allo stato originale.</li>
                    </ul>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <button class="btn btn-danger btn-lg shadow fw-bold d-inline-flex align-items-center gap-2"
                            @onclick="OpenResetModal"
                            disabled="@IsProcessing">
                        <span>🔥</span>
                        <span>RIPRISTINA DATABASE</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowResetModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">⚠️ CONFERMA DISTRUZIONE E RIPRISTINO</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseResetModal" disabled="@IsProcessing"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                        <span class="fs-3">💀</span>
                        <div class="small">
                            <strong>ATTENZIONE ESTREMA:</strong> Tutte le carte salvate e i dati attuali andranno persi definitivamente!
                        </div>
                    </div>
                    <p class="small text-muted mb-3">
                        Per confermare l'intenzione di azzerare e ripristinare il database allo stato di fabbrica con i set e font ufficiali, digita la parola <strong>RIPRISTINA</strong> nel campo sottostante:
                    </p>
                    <div class="mb-3">
                        <input type="text"
                               class="form-control form-control-lg text-center font-monospace fw-bold @(ResetConfirmationInput == "RIPRISTINA" ? "is-valid" : "")"
                               placeholder="Digita RIPRISTINA"
                               @bind="ResetConfirmationInput"
                               @bind:event="oninput"
                               disabled="@IsProcessing" />
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetModal" disabled="@IsProcessing">
                        Annulla
                    </button>
                    <button type="button"
                            class="btn btn-danger fw-bold px-4"
                            @onclick="ExecuteDatabaseReset"
                            disabled="@(ResetConfirmationInput != "RIPRISTINA" || IsProcessing)">
                        💥 Confermo, Ripristina Ora
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<BackupFileInfo> Backups = [];
    private BackupIntegrityReport? IntegrityReport;
    private string? SuccessMessage;
    private bool IsProcessing;
    private string? CurrentUserId;

    private bool ShowResetModal;
    private string ResetConfirmationInput = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var auth = await AuthStateTask;
            CurrentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        await LoadBackups();
    }

    private async Task LoadBackups()
    {
        var list = await BackupService.ListBackupsAsync();
        Backups = list.ToList();
    }

    private async Task TakeSnapshot()
    {
        IsProcessing = true;
        try
        {
            using (LoadingService.BeginScope("Creazione snapshot atomico del database in corso..."))
            {
                var info = await BackupService.CreateBackupAsync(CurrentUserId);
                SuccessMessage = $"Snapshot creato con successo: {info.FileName} ({FormatBytes(info.SizeBytes)}).";
                await LoadBackups();
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task VerifyIntegrity()
    {
        IsProcessing = true;
        try
        {
            using (LoadingService.BeginScope("Verifica integrità PRAGMA SQLite in corso..."))
            {
                IntegrityReport = await BackupService.VerifyDatabaseIntegrityAsync();
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task DeleteBackup(string fileName)
    {
        IsProcessing = true;
        try
        {
            using (LoadingService.BeginScope("Eliminazione snapshot..."))
            {
                await BackupService.DeleteBackupAsync(fileName, CurrentUserId);
                SuccessMessage = $"Snapshot {fileName} eliminato.";
                await LoadBackups();
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void OpenResetModal()
    {
        ResetConfirmationInput = "";
        ShowResetModal = true;
    }

    private void CloseResetModal()
    {
        if (IsProcessing) return;
        ShowResetModal = false;
        ResetConfirmationInput = "";
    }

    private async Task ExecuteDatabaseReset()
    {
        if (ResetConfirmationInput != "RIPRISTINA" || IsProcessing) return;

        IsProcessing = true;
        try
        {
            using (LoadingService.BeginScope("Ripristino di fabbrica del database in corso... Ricreazione schema e seeding set..."))
            {
                var result = await DatabaseResetService.ResetDatabaseAsync();
                if (result.Success)
                {
                    SuccessMessage = "Database ripristinato con successo allo stato di fabbrica! Tutti i template, set e font sono stati rigenerati.";
                    IntegrityReport = null;
                    await LoadBackups();
                    ShowResetModal = false;
                    ResetConfirmationInput = "";
                }
                else
                {
                    SuccessMessage = $"Errore durante il ripristino del database: {result.ErrorMessage}";
                }
            }
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}


