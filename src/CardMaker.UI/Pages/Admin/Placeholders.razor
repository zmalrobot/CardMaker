@page "/admin/placeholders"
@attribute [Authorize(Roles = "Admin")]

@using CardMaker.Application.Admin
@using CardMaker.Application.Common
@using CardMaker.UI.Components.Common
@inject IPlaceholderSeeder Seeder
@inject IAssetCatalog Catalog
@inject IAdminContentService ContentService
@inject AuthenticationStateProvider AuthProvider
@inject ILoadingService LoadingService

<PageTitle>Segnaposto — CardMaker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Frame e Simboli Segnaposto</h1>
        <p class="text-muted mb-0">
            Genera frame provvisori e simboli procedurali con le misure esatte della specifica asset per collaudare il motore prima della grafica definitiva.
            I segnaposto permettono di testare e comporre carte complete al 100% senza asset mancanti (ADR-010).
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <label class="form-label small fw-semibold mb-0" for="gameSelect">Gioco:</label>
            <select id="gameSelect" class="form-select form-select-sm w-auto" @bind="_selectedGameId" @bind:after="OnGameChanged">
                @foreach (var g in _games)
                {
                    <option value="@g.Id.ToString()">@g.NameIt</option>
                }
            </select>
        </div>
        <span class="badge bg-secondary-subtle text-secondary-emphasis">Geometria @(CurrentGeometry.Dpi) DPI</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Master Canvas</small>
                    <strong>@CurrentGeometry.MasterWidthPx × @CurrentGeometry.MasterHeightPx px</strong>
                    <span class="small text-muted d-block">(@(CurrentGeometry.WidthMm.ToString("0.#")) + bleed × @(CurrentGeometry.HeightMm.ToString("0.#")) mm)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Trim (Taglio)</small>
                    <strong>@CurrentGeometry.TrimWidthPx × @CurrentGeometry.TrimHeightPx px</strong>
                    <span class="small text-muted d-block">(offset @(CurrentGeometry.BleedPx), @(CurrentGeometry.BleedPx))</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Safe Zone / Angoli</small>
                    <strong>Safe: @CurrentGeometry.SafeZonePx px</strong>
                    <span class="small text-muted d-block">Raggio: @CurrentGeometry.CornerRadiusPx px</span>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex align-items-center gap-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="guides" @bind="_showGuides" />
                <label class="form-check-label small" for="guides">Disegna le guide di trim e safe zone sui frame</label>
            </div>
            <button class="btn btn-primary ms-auto" @onclick="GenerateAsync" disabled="@_busy">
                @(_busy ? "Generazione in corso..." : $"Genera segnaposto (Frame e Simboli) per {CurrentGameName}")
            </button>
        </div>

        @if (_result is not null)
        {
            <div class="alert alert-success mt-3 mb-0 shadow-sm">
                Generati <strong>@_result.Keys.Count</strong> asset segnaposto: @_result.Created nuovi, @_result.AlreadyPresent già presenti (deduplicati).
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Asset Segnaposto Generati per @CurrentGameName (@_generated.Count)</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Aggiorna</button>
    </div>
    <div class="card-body">
        @if (_generated.Count == 0)
        {
            <p class="text-muted text-center py-3 mb-0">Nessun segnaposto generato finora per questo gioco.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var asset in _generated)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="card h-100 shadow-sm">
                            <AssetImage AssetId="@asset.Id" Class="card-img-top p-1" Style="height:150px; object-fit:contain;" Alt="@asset.OriginalFileName" />
                            <div class="card-body p-2 text-center">
                                <small class="d-block text-truncate fw-medium" title="@asset.OriginalFileName">@asset.OriginalFileName</small>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@asset.Category</span>
                                <small class="text-muted d-block mt-1">@asset.PixelWidth × @asset.PixelHeight px</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<AdminGameDto> _games = [];
    private string _selectedGameId = string.Empty;
    private IReadOnlyList<Asset> _generated = [];
    private PlaceholderSeedResult? _result;
    private bool _showGuides;
    private bool _busy;

    private AdminGameDto? CurrentGame => _games.FirstOrDefault(g => g.Id.ToString() == _selectedGameId);
    private string CurrentGameName => CurrentGame?.NameIt ?? "Gioco";

    private CardGeometry CurrentGeometry
    {
        get
        {
            if (CurrentGame is not null)
            {
                return new CardGeometry
                {
                    WidthMm = (double)CurrentGame.WidthMm,
                    HeightMm = (double)CurrentGame.HeightMm,
                    BleedMm = (double)CurrentGame.BleedMm,
                    CornerRadiusMm = (double)CurrentGame.CornerRadiusMm,
                    SafeZoneMm = (double)CurrentGame.SafeZoneMm,
                    Dpi = CurrentGame.DefaultDpi,
                };
            }
            return CardGeometry.YuGiOh();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _games = await ContentService.GetGamesAsync();
        if (_games.Count > 0)
        {
            _selectedGameId = _games[0].Id.ToString();
        }
        await RefreshAsync();
    }

    private async Task OnGameChanged()
    {
        _result = null;
        await RefreshAsync();
    }

    private async Task GenerateAsync()
    {
        _busy = true;
        try
        {
            using (await LoadingService.BeginScopeAsync($"Generazione segnaposto per {CurrentGameName}..."))
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                Guid? gameId = Guid.TryParse(_selectedGameId, out var gid) ? gid : null;

                var key = CurrentGame?.Key?.ToLowerInvariant();
                if (key == "pokemon")
                {
                    _result = await Seeder.SeedPokemonAsync(userId, _showGuides, gameId);
                }
                else if (key == "mtg")
                {
                    _result = await Seeder.SeedMtgAsync(userId, _showGuides, gameId);
                }
                else
                {
                    _result = await Seeder.SeedYuGiOhAsync(userId, _showGuides, gameId);
                }

                await RefreshAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        Guid? gameId = Guid.TryParse(_selectedGameId, out var gid) ? gid : null;
        var all = await Catalog.ListAsync(gameId, 5000);
        _generated = all
            .Where(a => a.OriginalFileName.StartsWith("placeholder-", StringComparison.Ordinal) ||
                        a.Category == AssetCategory.Placeholder ||
                        a.Category == AssetCategory.CardBack ||
                        (a.Category == AssetCategory.Symbol && a.OriginalFileName.StartsWith("placeholder-symbol-", StringComparison.Ordinal)))
            .ToList();
    }
}
