@page "/admin/placeholders"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject IPlaceholderSeeder Seeder
@inject IAssetCatalog Catalog
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Segnaposto — CardMaker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Frame Segnaposto</h1>
        <p class="text-muted mb-0">
            Genera frame provvisori con le misure esatte della specifica asset per collaudare il motore prima della grafica definitiva.
            Quando arriveranno gli asset reali basterà ricaricarli al loro posto (ADR-010).
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">Geometria Yu-Gi-Oh! (@Geometry.Dpi DPI)</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Master Canvas</small>
                    <strong>@Geometry.MasterWidthPx × @Geometry.MasterHeightPx px</strong>
                    <span class="small text-muted d-block">(@(Geometry.WidthMm.ToString("0.#")) + bleed × @(Geometry.HeightMm.ToString("0.#")) mm)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Trim (Taglio)</small>
                    <strong>@Geometry.TrimWidthPx × @Geometry.TrimHeightPx px</strong>
                    <span class="small text-muted d-block">(offset @(Geometry.BleedPx), @(Geometry.BleedPx))</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-surface-2">
                    <small class="text-muted d-block">Safe Zone / Angoli</small>
                    <strong>Safe: @Geometry.SafeZonePx px</strong>
                    <span class="small text-muted d-block">Raggio: @Geometry.CornerRadiusPx px</span>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex align-items-center gap-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="guides" @bind="_showGuides" />
                <label class="form-check-label small" for="guides">Disegna le guide di trim e safe zone</label>
            </div>
            <button class="btn btn-primary ms-auto" @onclick="GenerateAsync" disabled="@_busy">
                @(_busy ? "Generazione in corso..." : "Genera i segnaposto Yu-Gi-Oh!")
            </button>
        </div>

        @if (_result is not null)
        {
            <div class="alert alert-success mt-3 mb-0 shadow-sm">
                Generati <strong>@_result.Keys.Count</strong> frame: @_result.Created nuovi, @_result.AlreadyPresent già presenti (deduplicati).
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Frame Segnaposto Generati (@_generated.Count)</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Aggiorna</button>
    </div>
    <div class="card-body">
        @if (_generated.Count == 0)
        {
            <p class="text-muted text-center py-3 mb-0">Nessun segnaposto generato finora.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var asset in _generated)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="card h-100 shadow-sm">
                            <img src="/assets/@asset.Id" class="card-img-top" alt="@asset.OriginalFileName" />
                            <div class="card-body p-2 text-center">
                                <small class="d-block text-truncate fw-medium" title="@asset.OriginalFileName">@asset.OriginalFileName</small>
                                <small class="text-muted">@asset.PixelWidth × @asset.PixelHeight px</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly CardGeometry Geometry = CardGeometry.YuGiOh();

    private IReadOnlyList<Asset> _generated = [];
    private PlaceholderSeedResult? _result;
    private bool _showGuides;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task GenerateAsync()
    {
        _busy = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            _result = await Seeder.SeedYuGiOhAsync(userId, _showGuides);
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        var all = await Catalog.ListAsync(null, 500);
        _generated = all
            .Where(a => a.OriginalFileName.StartsWith("placeholder-", StringComparison.Ordinal))
            .ToList();
    }
}
