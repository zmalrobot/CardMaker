@page "/admin/fonts"
@attribute [Authorize(Roles = "Admin")]

@using CardMaker.Application.Admin
@inject IFontCatalog Fonts
@inject IAdminContentService ContentService
@inject AuthenticationStateProvider AuthProvider
@inject CardMaker.Application.Common.ILoadingService LoadingService

<PageTitle>Ruoli Font — CardMaker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h3 mb-1">Ruoli Font</h1>
        <p class="text-muted mb-0">
            Ogni elemento di testo della carta ha il proprio font, identificato da un <em>alias di ruolo</em> (ADR-017).
            I ruoli font sono configurabili per gioco o condivisi a livello globale.
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">Carica e Assegna un Font</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="uploadGame">Gioco</label>
                <select id="uploadGame" class="form-select" @bind="_uploadGameId">
                    @foreach (var g in _games)
                    {
                        <option value="@g.Id">@g.NameIt</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="alias">Alias di ruolo</label>
                <input id="alias" class="form-control" list="role-suggestions" @bind="_alias"
                       placeholder="es. card-name" />
                <datalist id="role-suggestions">
                    @foreach (var role in GetRoleSuggestions())
                    {
                        <option value="@role"></option>
                    }
                </datalist>
                <div class="form-text small">Minuscolo, parole separate da trattino.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold" for="font-license">Licenza / provenienza (obbligatoria)</label>
                <input id="font-license" class="form-control" @bind="_licenseNote"
                       placeholder="Deve consentire l'incorporamento nel PDF" />
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">File Font</label>
                <InputFile OnChange="OnFileSelectedAsync" class="form-control" accept=".ttf,.otf" />
                <div class="form-text small">
                    Formati leggibili dal motore: <strong>.ttf</strong> e <strong>.otf</strong>.
                    I <code>.woff2</code> vengono rifiutati perché il renderer non li può aprire.
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 mb-0 shadow-sm">@_message</div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <span>Ruoli Assegnati (@_fonts.Count)</span>
            <select class="form-select form-select-sm w-auto" @bind="_filterGameId" @bind:after="RefreshAsync">
                <option value="">Tutti i giochi</option>
                @foreach (var g in _games)
                {
                    <option value="@g.Id.ToString()">@g.NameIt</option>
                }
            </select>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Aggiorna</button>
    </div>
    <div class="card-body p-0">
        @if (_fonts.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                Nessun font caricato per i criteri selezionati: il motore userà il font di ripiego per ogni testo.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Alias Ruolo</th>
                            <th>Gioco</th>
                            <th>Famiglia</th>
                            <th>Stile</th>
                            <th>Anteprima</th>
                            <th class="text-end pe-3">Azione</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var font in _fonts)
                        {
                            <tr>
                                <td class="ps-3"><code>@font.Alias</code></td>
                                <td>
                                    <span class="badge @(font.GameId.HasValue ? "bg-primary-subtle text-primary-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                        @GetGameName(font.GameId)
                                    </span>
                                </td>
                                <td class="fw-medium">@font.FamilyName</td>
                                <td>@font.StyleName (@font.Weight)</td>
                                <td><CardMaker.UI.Components.Common.FontPreviewImage FontId="@font.Id" Alt="@($"Anteprima di {font.Alias}")" Class="rounded border p-1" Style="max-height:40px" /></td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAsync(font.Id)">
                                        Rimuovi
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private const long MaxFontBytes = 8L * 1024 * 1024;

    private IReadOnlyList<FontAsset> _fonts = [];
    private IReadOnlyList<AdminGameDto> _games = [];
    private Guid? _uploadGameId;
    private string _filterGameId = string.Empty;
    private string _alias = string.Empty;
    private string _licenseNote = string.Empty;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _games = await ContentService.GetGamesAsync();
        if (_games.Count > 0)
        {
            _uploadGameId = _games[0].Id;
        }
        await RefreshAsync();
    }

    private IEnumerable<string> GetRoleSuggestions()
    {
        var game = _games.FirstOrDefault(g => g.Id == _uploadGameId);
        var key = game?.Key?.ToLowerInvariant();
        return key switch
        {
            "pokemon" => FontRoleSuggestions.Pokemon,
            "mtg" => FontRoleSuggestions.Mtg,
            _ => FontRoleSuggestions.YuGiOh,
        };
    }

    private string GetGameName(Guid? gameId)
    {
        if (!gameId.HasValue) return "Nessuno";
        return _games.FirstOrDefault(g => g.Id == gameId.Value)?.NameIt ?? "Sconosciuto";
    }

    private async Task RefreshAsync()
    {
        if (Guid.TryParse(_filterGameId, out var gid))
        {
            _fonts = (await Fonts.ListAsync(gid)).ToList();
        }
        else
        {
            _fonts = (await Fonts.ListAsync()).ToList();
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        using (await LoadingService.BeginScopeAsync($"Registrazione font '{_alias}'..."))
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            await using var stream = e.File.OpenReadStream(MaxFontBytes);
            var outcome = await Fonts.RegisterAsync(stream, new FontRegistrationRequest
            {
                FileName = e.File.Name,
                Alias = _alias,
                LicenseNote = _licenseNote,
                GameId = _uploadGameId,
                UploadedByUserId = userId,
            });

            if (outcome.Succeeded)
            {
                Show($"Font '{outcome.Font!.FamilyName}' assegnato al ruolo '{outcome.Font.Alias}'.", isError: false);
                _alias = string.Empty;
                await RefreshAsync();
            }
            else
            {
                Show(Describe(outcome.ErrorCode!), isError: true);
            }
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        using (await LoadingService.BeginScopeAsync("Rimozione ruolo font..."))
        {
            await Fonts.RemoveAsync(id);
            await RefreshAsync();
        }
    }

    private void Show(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

    private static string Describe(string errorCode) => errorCode switch
    {
        "font.invalidAlias" => "Alias non valido: usa solo minuscole, cifre e trattini (es. card-name).",
        "font.aliasAlreadyUsed" => "Questo alias è già assegnato a un altro font: rimuovilo prima di sostituirlo.",
        "font.notReadableByRenderer" => "Il motore di rendering non riesce ad aprire questo file: usa .ttf o .otf.",
        "asset.licenseRequired" => "Indica licenza o provenienza del font.",
        "upload.unsupportedFontFormat" => "Formato non riconosciuto: sono ammessi .ttf e .otf.",
        "upload.tooLarge" => "File troppo grande (massimo 8 MB).",
        _ => $"Caricamento rifiutato ({errorCode}).",
    };
}
