@inject IJSRuntime JS

<div class="btn-group btn-group-sm" role="group" aria-label="Selettore tema">
    <button type="button" 
            class="btn @(CurrentTheme == "light" ? "btn-primary" : "btn-outline-secondary")"
            title="Tema chiaro"
            @onclick='() => SetThemeAsync("light")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <span class="d-none d-md-inline ms-1">Chiaro</span>
    </button>
    <button type="button" 
            class="btn @(CurrentTheme == "system" ? "btn-primary" : "btn-outline-secondary")"
            title="Tema di sistema"
            @onclick='() => SetThemeAsync("system")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span class="d-none d-md-inline ms-1">Auto</span>
    </button>
    <button type="button" 
            class="btn @(CurrentTheme == "dark" ? "btn-primary" : "btn-outline-secondary")"
            title="Tema scuro"
            @onclick='() => SetThemeAsync("dark")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="d-none d-md-inline ms-1">Scuro</span>
    </button>
</div>

@code {
    private string CurrentTheme = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                CurrentTheme = await JS.InvokeAsync<string>("cardMakerTheme.getTheme");
                StateHasChanged();
            }
            catch (JSException)
            {
                // Fallback for SSR or non-JS environments
            }
        }
    }

    private async Task SetThemeAsync(string theme)
    {
        CurrentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("cardMakerTheme.setTheme", theme);
        }
        catch (JSException)
        {
            // Fallback
        }
    }
}

