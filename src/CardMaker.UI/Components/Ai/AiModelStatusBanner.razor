@using CardMaker.Application.Ai
@using CardMaker.Contracts.Ai
@implements IDisposable
@inject IAiModelManager ModelManager

@if (ModelManager.ActiveProgress != null && (ModelManager.CurrentStatus == AiModelReadinessStatus.Downloading || ModelManager.CurrentImageStatus == AiModelReadinessStatus.Downloading))
{
    var p = ModelManager.ActiveProgress;
    var speedMb = Math.Round(p.BytesPerSecond / (1024.0 * 1024.0), 1);
    var downloadedMb = Math.Round((double)p.BytesDownloaded / (1024.0 * 1024.0), 1);
    var totalMb = Math.Round((double)p.TotalBytes / (1024.0 * 1024.0), 1);

    <div class="alert alert-info shadow-sm mb-3 border-info-subtle d-flex flex-column gap-2" role="status">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <strong>Download Modello AI in corso:</strong>
                <span class="badge bg-primary">@p.ModelDisplayName</span>
            </div>
            <div class="small text-muted d-flex align-items-center gap-3">
                @if (speedMb > 0)
                {
                    <span>⚡ @speedMb MB/s</span>
                }
                @if (p.EstimatedRemaining.HasValue)
                {
                    <span>⏳ ETA: @FormatEta(p.EstimatedRemaining.Value)</span>
                }
                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="CancelDownload">
                    Interrompi
                </button>
            </div>
        </div>

        <div class="progress" style="height: 8px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                 role="progressbar" 
                 style="width: @(p.Percentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;" 
                 aria-valuenow="@p.Percentage" 
                 aria-valuemin="0" 
                 aria-valuemax="100">
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center small text-muted">
            <span>@downloadedMb MB / @totalMb MB (@(p.Percentage.ToString("0.0"))%)</span>
            <span>L'applicazione e utilizzabile durante il download</span>
        </div>
    </div>
}
else if (ModelManager.CurrentStatus == AiModelReadinessStatus.Validating || ModelManager.CurrentImageStatus == AiModelReadinessStatus.Validating)
{
    <div class="alert alert-warning shadow-sm mb-3 py-2 d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
        <span>Validazione e verifica dell'integrita del file GGUF in corso...</span>
    </div>
}
else if ((ModelManager.CurrentStatus == AiModelReadinessStatus.Error && ModelManager.CurrentProgress?.ErrorMessage != null) ||
         (ModelManager.CurrentImageStatus == AiModelReadinessStatus.Error && ModelManager.CurrentImageProgress?.ErrorMessage != null))
{
    var err = ModelManager.CurrentProgress?.ErrorMessage ?? ModelManager.CurrentImageProgress?.ErrorMessage;
    <div class="alert alert-danger shadow-sm mb-3 d-flex align-items-center justify-content-between py-2">
        <div class="d-flex align-items-center gap-2 small">
            <span>⚠️</span>
            <span>@err</span>
        </div>
        <button type="button" class="btn btn-danger btn-sm py-0 px-2" @onclick="RetryDownloadAsync">
            🔄 Riprova Download
        </button>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ModelManager.OnStatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void CancelDownload()
    {
        ModelManager.CancelDownload();
        ModelManager.CancelImageDownload();
    }

    private async Task RetryDownloadAsync()
    {
        await ModelManager.EnsureAllActiveModelsReadyAsync(forceDownload: true);
    }

    private static string FormatEta(TimeSpan eta)
    {
        if (eta.TotalHours >= 1)
        {
            return $"{(int)eta.TotalHours}h {eta.Minutes}m";
        }
        if (eta.TotalMinutes >= 1)
        {
            return $"{eta.Minutes}m {eta.Seconds}s";
        }
        return $"{Math.Max(1, eta.Seconds)}s";
    }

    public void Dispose()
    {
        ModelManager.OnStatusChanged -= OnStatusChanged;
    }
}
