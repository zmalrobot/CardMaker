@using CardMaker.AI.Abstractions
@using CardMaker.AI.Models
@using CardMaker.Application.Ai
@using CardMaker.Contracts.Ai
@implements IAsyncDisposable
@inject ICardTextGenerationService TextGenService
@inject IAiConfigurationService AiConfigService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-surface-1">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span>✨</span>
                        <span>Genera Titolo e Descrizione con AI</span>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Chiudi" @onclick="CloseAsync" disabled="@(CurrentStage == AiProgressStage.LoadingModel)"></button>
                </div>

                <div class="modal-body">
                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger shadow-sm mb-3">
                            <div class="fw-semibold mb-1">⚠️ Errore durante la generazione</div>
                            <div class="small" style="white-space: pre-line;">@ErrorMessage</div>
                            @if (ActiveModel != null && ErrorMessage.Contains(".gguf", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mt-2 pt-2 border-top border-danger-subtle small">
                                    <strong>Modello richiesto:</strong> <code>@ActiveModel.FileName</code><br />
                                    Puoi scaricare il file GGUF da: 
                                    <a href="@ActiveModel.DownloadUrl" target="_blank" rel="noopener noreferrer" class="alert-link">
                                        @ActiveModel.DownloadUrl
                                    </a><br />
                                    e collocarlo nella cartella: <code>@AiConfigService.GetModelsDirectory()</code>
                                </div>
                            }
                        </div>
                    }

                    @if (CurrentStage == AiProgressStage.Idle || CurrentStage == AiProgressStage.Error)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Di che carta si tratta? Descrivi la tua idea o tema:</label>
                            <textarea class="form-control" rows="3" 
                                      placeholder="Es. Un drago sputafuoco antico che risorge dal cimitero scartando una carta magia..."
                                      @bind="UserPrompt" 
                                      @bind:event="oninput"></textarea>
                            <div class="form-text">
                                Gioco: <strong>@FormatGameName(GameKey)</strong> 
                                @if (!string.IsNullOrWhiteSpace(CardTypeName))
                                {
                                    <span> | Tipo: <strong>@CardTypeName</strong></span>
                                }
                                else if (!string.IsNullOrWhiteSpace(CardTypeKey))
                                {
                                    <span> | Tipo: <strong>@CardTypeKey</strong></span>
                                }
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Stile narrativo</label>
                                <select class="form-select" @bind="SelectedStyleKey">
                                    @foreach (var style in AvailableStyles)
                                    {
                                        <option value="@style.Key">@style.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Modello attivo</label>
                                <input type="text" class="form-control bg-light" readonly value="@(ActiveModel?.DisplayName ?? "Rilevamento in corso...")" />
                            </div>
                        </div>
                    }
                    else if (CurrentStage == AiProgressStage.LoadingModel || CurrentStage == AiProgressStage.Generating || CurrentStage == AiProgressStage.Preparing)
                    {
                        <div class="py-4 text-center">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                            <h5 class="fw-bold mb-2">@StatusMessage</h5>
                            <p class="text-muted small mb-3">
                                L'inferenza locale viene eseguita sulla tua CPU senza inviare dati all'esterno.
                            </p>

                            @if (!string.IsNullOrEmpty(LivePreviewText))
                            {
                                <div class="card bg-surface-2 text-start p-3 mx-auto" style="max-width: 600px; max-height: 180px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                                    @LivePreviewText
                                </div>
                            }

                            <div class="mt-4">
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="CancelGeneration">
                                    ⏹️ Interrompi Generazione
                                </button>
                            </div>
                        </div>
                    }
                    else if (CurrentStage == AiProgressStage.Completed)
                    {
                        <div class="alert alert-success d-flex align-items-center justify-content-between py-2 px-3 mb-3">
                            <div class="small">
                                <span>✅ Generazione completata con successo in <strong>@LastDurationMs ms</strong></span>
                                <span class="text-muted ms-2">(Modello: @LastModelUsed)</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Titolo Generato</label>
                            <input type="text" class="form-control fw-bold" @bind="GeneratedTitle" />
                        </div>

                        @if (SupportsAttack || SupportsDefense)
                        {
                            <div class="row g-3 mb-3">
                                @if (SupportsAttack)
                                {
                                    <div class="@(SupportsDefense ? "col-6" : "col-12")">
                                        <label class="form-label small fw-semibold">Attacco (ATK)</label>
                                        <input type="number" class="form-control" @bind="GeneratedAttack" placeholder="Es. 2500" />
                                    </div>
                                }
                                @if (SupportsDefense)
                                {
                                    <div class="@(SupportsAttack ? "col-6" : "col-12")">
                                        <label class="form-label small fw-semibold">Difesa (DEF)</label>
                                        <input type="number" class="form-control" @bind="GeneratedDefense" placeholder="Es. 2100" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Descrizione / Effetto Generato</label>
                            <textarea class="form-control" rows="5" @bind="GeneratedDescription"></textarea>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-surface-1">
                    @if (CurrentStage == AiProgressStage.Completed)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Annulla</button>
                        <button type="button" class="btn btn-outline-primary" @onclick="GenerateAlternativeAsync" disabled="@IsProcessing">
                            🔄 Genera Alternativa
                        </button>
                        <button type="button" class="btn btn-success" @onclick="AcceptAndApplyAsync">
                            ✔️ Applica alla Carta
                        </button>
                    }
                    else if (CurrentStage == AiProgressStage.Idle || CurrentStage == AiProgressStage.Error)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Chiudi</button>
                        <button type="button" class="btn btn-primary" @onclick="StartGenerationAsync" disabled="@(string.IsNullOrWhiteSpace(UserPrompt) || IsProcessing)">
                            ✨ Genera con AI
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string GameKey { get; set; } = string.Empty;
    [Parameter] public string CardTypeKey { get; set; } = string.Empty;
    [Parameter] public string CardTypeName { get; set; } = string.Empty;
    [Parameter] public bool SupportsAttack { get; set; }
    [Parameter] public bool SupportsDefense { get; set; }
    [Parameter] public string CurrentTitle { get; set; } = string.Empty;
    [Parameter] public EventCallback<CardAiGenerationResultDto> OnAccept { get; set; }

    private IReadOnlyList<AiStyleDto> AvailableStyles = [];
    private string SelectedStyleKey = "classico";
    private string UserPrompt = string.Empty;
    private AiModelDefinition? ActiveModel;

    private AiProgressStage CurrentStage = AiProgressStage.Idle;
    private string StatusMessage = "Pronto";
    private string LivePreviewText = string.Empty;
    private string? ErrorMessage;

    private string GeneratedTitle = string.Empty;
    private string GeneratedDescription = string.Empty;
    private int? GeneratedAttack;
    private int? GeneratedDefense;
    private long LastDurationMs;
    private string LastModelUsed = string.Empty;

    private bool IsProcessing => CurrentStage == AiProgressStage.LoadingModel || CurrentStage == AiProgressStage.Generating || CurrentStage == AiProgressStage.Preparing;
    private CancellationTokenSource? _cts;
    private bool _hasInitialized;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_hasInitialized)
        {
            _hasInitialized = true;
            AvailableStyles = TextGenService.GetAvailableStyles();
            if (AvailableStyles.Count > 0)
            {
                SelectedStyleKey = AvailableStyles[0].Key;
            }

            try
            {
                ActiveModel = await AiConfigService.GetActiveModelDefinitionAsync();
            }
            catch
            {
                // Ignora se non caricabile in questo momento
            }

            if (string.IsNullOrWhiteSpace(UserPrompt) && !string.IsNullOrWhiteSpace(CurrentTitle) && !CurrentTitle.StartsWith("Nuovo", StringComparison.OrdinalIgnoreCase))
            {
                UserPrompt = $"Evoluzione o variante basata su '{CurrentTitle}'";
            }
        }
        else if (!IsOpen)
        {
            _hasInitialized = false;
        }
    }

    private async Task StartGenerationAsync()
    {
        ErrorMessage = null;
        LivePreviewText = string.Empty;
        CurrentStage = AiProgressStage.Preparing;
        StatusMessage = "Preparazione sessione...";

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        var progress = new Progress<AiProgressUpdate>(update =>
        {
            InvokeAsync(() =>
            {
                CurrentStage = update.Stage;
                StatusMessage = update.StatusMessage;
                if (!string.IsNullOrEmpty(update.PartialToken))
                {
                    LivePreviewText += update.PartialToken;
                }
                StateHasChanged();
            });
        });

        try
        {
            var request = new CardAiGenerationRequestDto
            {
                GameKey = GameKey,
                CardTypeKey = CardTypeKey,
                CardTypeName = CardTypeName,
                SupportsAttack = SupportsAttack,
                SupportsDefense = SupportsDefense,
                StyleKey = SelectedStyleKey,
                UserPrompt = UserPrompt,
                ExistingTitle = CurrentTitle
            };

            var result = await TextGenService.GenerateCardTextAsync(request, progress, _cts.Token);

            GeneratedTitle = result.Title;
            GeneratedDescription = result.Description;
            GeneratedAttack = result.Attack;
            GeneratedDefense = result.Defense;
            LastDurationMs = result.DurationMs;
            LastModelUsed = result.ModelUsed;
            CurrentStage = AiProgressStage.Completed;
        }
        catch (OperationCanceledException)
        {
            CurrentStage = AiProgressStage.Idle;
            StatusMessage = "Operazione interrotta.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            CurrentStage = AiProgressStage.Error;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task GenerateAlternativeAsync()
    {
        TextGenService.ResetContext();
        await StartGenerationAsync();
    }

    private void CancelGeneration()
    {
        _cts?.Cancel();
    }

    private async Task AcceptAndApplyAsync()
    {
        var result = new CardAiGenerationResultDto
        {
            Title = GeneratedTitle,
            Description = GeneratedDescription,
            Attack = GeneratedAttack,
            Defense = GeneratedDefense,
            DurationMs = LastDurationMs,
            ModelUsed = LastModelUsed
        };

        await OnAccept.InvokeAsync(result);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        CurrentStage = AiProgressStage.Idle;
        ErrorMessage = null;
        LivePreviewText = string.Empty;

        // Rilascia le risorse native della sessione del modello per azzerare l'impronta di memoria
        try
        {
            await TextGenService.UnloadModelAsync();
        }
        catch
        {
            // Tollerante agli errori in chiusura
        }

        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private static string FormatGameName(string? key) => (key ?? string.Empty).ToLowerInvariant() switch
    {
        "yugioh" => "Yu-Gi-Oh!",
        "pokemon" => "Pokémon",
        "mtg" => "Magic: The Gathering",
        _ => "Generico"
    };

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        try
        {
            await TextGenService.UnloadModelAsync();
        }
        catch
        {
            // Ignora eccezioni in fase di teardown
        }
    }
}
