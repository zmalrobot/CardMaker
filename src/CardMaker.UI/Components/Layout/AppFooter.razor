@using System.Reflection
@using CardMaker.Application.Ai
@using CardMaker.Contracts.Ai
@implements IDisposable
@inject IAiModelManager ModelManager

<footer class="cm-footer border-top py-2 mt-auto bg-surface-1">
    <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-3 px-4 small text-muted">
        <div>
            @if (ModelManager.CurrentStatus == AiModelReadinessStatus.Downloading && ModelManager.CurrentProgress != null)
            {
                var p = ModelManager.CurrentProgress;
                <div class="d-flex align-items-center gap-2 text-primary fw-semibold">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Download Modello AI (@p.ModelDisplayName): @(p.Percentage.ToString("0.0"))%</span>
                    <span class="text-muted fw-normal">(@Math.Round((double)p.BytesDownloaded / (1024 * 1024), 1) MB / @Math.Round((double)p.TotalBytes / (1024 * 1024), 1) MB)</span>
                </div>
            }
            else if (ModelManager.CurrentStatus == AiModelReadinessStatus.Validating)
            {
                <div class="d-flex align-items-center gap-2 text-warning fw-semibold">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Validazione file modello in corso...</span>
                </div>
            }
            else if (ModelManager.CurrentStatus == AiModelReadinessStatus.Ready)
            {
                <span class="text-success d-flex align-items-center gap-1">
                    <span>✅</span>
                    <span>Modello AI Pronto: @(ModelManager.ActiveModel?.DisplayName ?? "Caricato")</span>
                </span>
            }
        </div>

        <div class="d-flex flex-wrap justify-content-end align-items-center gap-3">
            <a href="disclaimer" class="text-decoration-none text-muted hover-underline">Note legali</a>
            <span class="text-secondary opacity-50">·</span>
            <span>Versione applicativo desktop: @_appVersion</span>
            <span class="text-secondary opacity-50">·</span>
            <span>Versione motore di rendering: @_renderingVersion</span>
            <span class="text-secondary opacity-50">·</span>
            <span>Versione motore AI: @_aiEngineVersion</span>
        </div>
    </div>
</footer>

@code {
    private static readonly string _appVersion = GetAppVersion();
    private static readonly string _renderingVersion = GetRenderingVersion();
    private static readonly string _aiEngineVersion = GetAiEngineVersion();

    protected override void OnInitialized()
    {
        ModelManager.OnStatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ModelManager.OnStatusChanged -= OnStatusChanged;
    }

    private static string GetAppVersion()
    {
        try
        {
            var asm = Assembly.GetEntryAssembly() ?? typeof(AppFooter).Assembly;
            var ver = asm.GetName().Version;
            return ver != null ? $"{ver.Major}.{ver.Minor}.{ver.Build}" : "1.0.0";
        }
        catch
        {
            return "1.0.0";
        }
    }

    private static string GetRenderingVersion()
    {
        try
        {
            var asm = AppDomain.CurrentDomain.GetAssemblies()
                .FirstOrDefault(a => string.Equals(a.GetName().Name, "CardMaker.Rendering", StringComparison.OrdinalIgnoreCase))
                ?? Assembly.Load("CardMaker.Rendering");
            var ver = asm?.GetName().Version;
            return ver != null ? $"{ver.Major}.{ver.Minor}.{ver.Build}" : "1.0.0";
        }
        catch
        {
            return "1.0.0";
        }
    }

    private static string GetAiEngineVersion()
    {
        try
        {
            var asm = typeof(CardMaker.AI.Engines.LlamaCppTextEngine).Assembly;
            var ver = asm.GetName().Version;
            var verStr = ver != null ? $"{ver.Major}.{ver.Minor}.{ver.Build}" : "1.0.0";
            return $"llama.cpp (CardMaker.AI {verStr} / LLamaSharp 0.27.0)";
        }
        catch
        {
            return "llama.cpp / LLamaSharp 0.27.0";
        }
    }
}
