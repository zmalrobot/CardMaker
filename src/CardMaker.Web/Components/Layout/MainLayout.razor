@inherits LayoutComponentBase

<div class="cm-app-layout">
    <aside class="cm-sidebar @(SidebarExpanded ? "show" : "")">
        <NavMenu />
    </aside>

    <div class="cm-main-container">
        <header class="cm-topbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary d-lg-none"
                        aria-label="Menu"
                        onclick="cardMaker?.toggleSidebar()"
                        @onclick="ToggleSidebar">
                    ☰
                </button>
                <span class="fw-semibold d-none d-sm-inline">CardMaker Studio</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <ThemeToggle @rendermode="InteractiveServer" />
            </div>
        </header>

        <main class="cm-content">
            @Body
        </main>

        <CardMaker.UI.Components.Layout.AppFooter />
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool SidebarExpanded;

    private void ToggleSidebar()
    {
        SidebarExpanded = !SidebarExpanded;
    }
}
