@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="cm-app-layout">
    <aside class="cm-sidebar @(SidebarExpanded ? "show" : "")">
        <NavMenu />
    </aside>

    <div class="cm-main-container">
        @if (_isNavigating)
        {
            <div class="cm-page-loading-bar" role="progressbar" aria-label="Caricamento pagina"></div>
        }

        <header class="cm-topbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary d-lg-none"
                        aria-label="Menu"
                        @onclick="ToggleSidebar">
                    ☰
                </button>
                <span class="fw-semibold d-none d-sm-inline">CardMaker</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <CardMaker.UI.Components.Localization.LanguageToggle />
                <ThemeToggle />
            </div>
        </header>

        <main class="cm-content">
            <div class="cm-page-transition" @key="NavigationManager.Uri">
                @Body
            </div>
        </main>

        <CardMaker.UI.Components.Layout.AppFooter />
    </div>
</div>

<CardMaker.UI.Components.Common.GlobalLoadingOverlay />

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool SidebarExpanded;
    private bool _isNavigating;
    private CancellationTokenSource? _navCts;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navCts?.Cancel();
        _navCts = new CancellationTokenSource();
        var token = _navCts.Token;

        _isNavigating = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(260, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        _isNavigating = false;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private void ToggleSidebar()
    {
        SidebarExpanded = !SidebarExpanded;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _navCts?.Cancel();
        _navCts?.Dispose();
    }
}

