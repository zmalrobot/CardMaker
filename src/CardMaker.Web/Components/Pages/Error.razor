@page "/Error"
@using System.Diagnostics

<PageTitle>Errore — CardMaker</PageTitle>

<div class="card shadow-sm border p-4 my-4 text-center mx-auto" style="max-width: 600px;">
    <div class="display-5 text-danger mb-3">⚠️</div>
    <h1 class="h4 text-danger fw-bold mb-2">Si è verificato un errore</h1>
    <p class="text-muted mb-4">Si è verificato un problema imprevisto durante l'elaborazione della tua richiesta.</p>
    @if (ShowRequestId)
    {
        <p class="small text-muted mb-4">
            <strong>ID Richiesta:</strong> <code>@RequestId</code>
        </p>
    }
    <div>
        <a href="" class="btn btn-primary">Torna alla Home</a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
