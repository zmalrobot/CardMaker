@using Microsoft.AspNetCore.Identity
@using CardMaker.Infrastructure.Identity

@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <NavLink class="nav-link px-3 py-2" href="Account/Manage" Match="NavLinkMatch.All">Profilo</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link px-3 py-2" href="Account/Manage/Email">Email</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link px-3 py-2" href="Account/Manage/ChangePassword">Password</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class="nav-link px-3 py-2" href="Account/Manage/ExternalLogins">Accessi esterni</NavLink>
        </li>
    }
    <li class="nav-item">
        <NavLink class="nav-link px-3 py-2" href="Account/Manage/TwoFactorAuthentication">Autenticazione a due fattori</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link px-3 py-2" href="Account/Manage/PersonalData">Dati personali</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
