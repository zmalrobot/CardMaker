@using CardMaker.Web.Components.Account.Shared
<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="_uiAssemblies"
        NotFoundPage="typeof(Pages.NotFound)">
    <Navigating>
        <div class="cm-page-loading-bar" role="progressbar" aria-label="Caricamento pagina"></div>
    </Navigating>
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Le pagine applicative vivono nella Razor Class Library condivisa con l'host desktop.
    private static readonly System.Reflection.Assembly[] _uiAssemblies =
        [typeof(CardMaker.UI.Pages.Admin.AssetLibrary).Assembly];
}
