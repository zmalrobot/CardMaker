<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CardMaker.Desktop</RootNamespace>
    <AssemblyName>CardMaker</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyTitle>CardMaker</AssemblyTitle>
    <Title>CardMaker</Title>
    <Description>CardMaker</Description>
    <PackageId>CardMaker</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardMaker.Domain\CardMaker.Domain.csproj" />
    <ProjectReference Include="..\CardMaker.Contracts\CardMaker.Contracts.csproj" />
    <ProjectReference Include="..\CardMaker.Application\CardMaker.Application.csproj" />
    <ProjectReference Include="..\CardMaker.Rendering\CardMaker.Rendering.csproj" />
    <ProjectReference Include="..\CardMaker.Infrastructure\CardMaker.Infrastructure.csproj" />
    <ProjectReference Include="..\CardMaker.UI\CardMaker.UI.csproj" />
  </ItemGroup>

</Project>
