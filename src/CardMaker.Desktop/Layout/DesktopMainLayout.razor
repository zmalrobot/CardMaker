@inherits LayoutComponentBase

<div class="cm-app-layout">
    <aside class="cm-sidebar @(SidebarExpanded ? "show" : "")">
        <DesktopNavMenu />
    </aside>

    <div class="cm-main-container">
        <header class="cm-topbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary d-lg-none"
                        aria-label="Menu"
                        @onclick="ToggleSidebar">
                    ☰
                </button>
                <span class="fw-semibold d-none d-sm-inline">CardMaker Desktop</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <CardMaker.UI.Components.Localization.LanguageToggle />
                <ThemeToggle />
            </div>
        </header>

        <main class="cm-content">
            @Body
        </main>

        <CardMaker.UI.Components.Layout.AppFooter />
    </div>
</div>

<CardMaker.UI.Components.Common.GlobalLoadingOverlay />

@code {
    private bool SidebarExpanded;

    private void ToggleSidebar()
    {
        SidebarExpanded = !SidebarExpanded;
    }
}

